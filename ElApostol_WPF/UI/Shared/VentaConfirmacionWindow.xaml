<Window x:Class="ElApostol_WPF.UI.Shared.VentaConfirmacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="El Apóstol — Confirmar Venta"
        Height="540" Width="560"
        MinHeight="480" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">

    <Window.Resources>
        <!-- Encabezado de tabla -->
        <Style x:Key="ThHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E4208"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Botón verde sólido (Confirmar) -->
        <Style x:Key="BtnVerde" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#2E7D32" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón rojo fantasma (Cancelar) -->
        <Style x:Key="BtnRojo" TargetType="Button">
            <Setter Property="Foreground"      Value="#6B1A1A"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="BorderBrush"     Value="#DDDDDD"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FCEBEB"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#A32D2D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón verde suave (Guardar PDF) -->
        <Style x:Key="BtnVerdeSoft" TargetType="Button">
            <Setter Property="Foreground"      Value="#1E4208"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="BorderBrush"     Value="#2E7D32"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#EAF3DE"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C0DD97"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Comprobante -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="#1B5E20">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtTituloConfirmacion" Grid.Column="0"
                           Text="Confirmar venta"
                           FontSize="15" FontWeight="Medium" Foreground="White"
                           VerticalAlignment="Center"/>
                <Border Grid.Column="1"
                        Background="#FFFFFF22" CornerRadius="20" Padding="10,3">
                    <TextBlock x:Name="TxtNumeroComprobante"
                               Text="Comprobante #VTA-00000"
                               FontSize="12" Foreground="Black"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ COMPROBANTE ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,10,12,6">
            <Border Background="White" CornerRadius="7"
                    BorderBrush="#E0E0E0" BorderThickness="0.5">
                <StackPanel>

                    <!-- Cabecera negocio + meta -->
                    <Grid Margin="14,10,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="El Apóstol"
                                       FontSize="15" FontWeight="SemiBold" Foreground="#111111"/>
                            <TextBlock Text="Materiales de construcción"
                                       FontSize="12" Foreground="#666666" Margin="0,1,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtFecha"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="#111111" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TxtHora"
                                       FontSize="12" Foreground="#555555"
                                       HorizontalAlignment="Right" Margin="0,1,0,0"/>
                            <TextBlock x:Name="TxtNumComp2"
                                       FontSize="12" Foreground="#555555"
                                       HorizontalAlignment="Right" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="#EEEEEE" BorderThickness="0,0.5,0,0"/>

                    <!-- Empleado -->
                    <Border Background="White" Padding="14,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#2E7D32" Margin="0,0,7,0"/>
                            <TextBlock FontSize="13" Foreground="#555555">
                                <Run Text="Atendido por: "/>
                                <Run x:Name="RunEmpleado" FontWeight="SemiBold" Foreground="#111111"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#EEEEEE" BorderThickness="0,0.5,0,0"/>

                    <!-- Encabezado tabla ítems -->
                    <Grid Background="#E4F0D6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Material"  Style="{StaticResource ThHeader}" Margin="14,7,0,7"/>
                        <TextBlock Grid.Column="1" Text="Medida"    Style="{StaticResource ThHeader}"/>
                        <TextBlock Grid.Column="2" Text="Cant."     Style="{StaticResource ThHeader}"/>
                        <TextBlock Grid.Column="3" Text="P. Unit."  Style="{StaticResource ThHeader}"/>
                        <TextBlock Grid.Column="4" Text="Subtotal"  Style="{StaticResource ThHeader}" Margin="0,7,14,7"/>
                    </Grid>

                    <!-- Filas de ítems -->
                    <ItemsControl x:Name="IcItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,0.5">
                                    <Grid Margin="0,6,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding NombreProducto}"
                                                   FontSize="13" Foreground="#111111" Margin="14,0,0,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Medida}"
                                                   FontSize="13" Foreground="#555555" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Cantidad}"
                                                   FontSize="13" Foreground="#555555" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding PrecioDisplay}"
                                                   FontSize="13" Foreground="#555555" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding SubtotalDisplay}"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#1B5E20"
                                                   Margin="0,0,14,0" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="#EEEEEE" BorderThickness="0,0.5,0,0"/>

                    <!-- Totales -->
                    <StackPanel Margin="14,9,14,9" Background="White">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Subtotal" FontSize="13" Foreground="#444444"/>
                            <TextBlock x:Name="TxtConfSubtotal"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#111111"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid x:Name="FilaRecargoConf" Visibility="Collapsed" Margin="0,0,0,4">
                            <TextBlock x:Name="TxtLabelRecargoConf"
                                       FontSize="13" Foreground="#4D2B00"/>
                            <TextBlock x:Name="TxtConfRecargo"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#4D2B00"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Border BorderBrush="#DDDDDD" BorderThickness="0,0.5,0,0" Margin="0,3,0,5"/>
                        <Grid>
                            <TextBlock Text="Total" FontSize="16" FontWeight="SemiBold" Foreground="#1B5E20"/>
                            <TextBlock x:Name="TxtConfTotal"
                                       FontSize="16" FontWeight="SemiBold" Foreground="#1B5E20"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <Border BorderBrush="#EEEEEE" BorderThickness="0,0.5,0,0"/>

                    <!-- Método de pago + observaciones -->
                    <Grid Background="#F5F5F5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="#EAF3DE" CornerRadius="20"
                                Padding="11,4" Margin="14,8,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="IconoMetodo"
                                      Data="M1,4 H15 V13 Q15,14 14,14 H2 Q1,14 1,13 Z M1,7 H15"
                                      Stroke="#1E4208" StrokeThickness="1.2"
                                      Width="14" Height="10" Stretch="Uniform"
                                      Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtMetodoBadge"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#1E4208" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   x:Name="TxtObsConf"
                                   FontSize="12" Foreground="#888888"
                                   FontStyle="Italic"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="8,8,14,8"
                                   TextWrapping="Wrap"/>
                    </Grid>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ═══ FOOTER ═══ -->
        <Border Grid.Row="2"
                BorderBrush="#DDDDDD" BorderThickness="0,0.5,0,0"
                Background="White" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Guardar PDF -->
                <Button x:Name="BtnPdf" Grid.Column="0"
                        Style="{StaticResource BtnVerdeSoft}"
                        Padding="11,7"
                        IsEnabled="False"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Disponible una vez confirmada la venta"
                        Click="BtnPdf_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M8,2 V10 M5,7 L8,10 L11,7 M2,12 H14"
                              Stroke="#1E4208" StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              Width="13" Height="13" Stretch="Uniform"
                              Margin="0,0,6,0"/>
                        <TextBlock Text="Guardar comprobante PDF"
                                   FontSize="13" FontWeight="Medium" Foreground="#1E4208"/>
                    </StackPanel>
                </Button>

                <!-- Cancelar + Confirmar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnCancelar" Content="Cancelar"
                            Style="{StaticResource BtnRojo}"
                            Padding="14,8" Margin="0,0,8,0"
                            FontSize="13"
                            Click="BtnCancelar_Click"/>
                    <Button x:Name="BtnConfirmar" Content="Confirmar venta"
                            Style="{StaticResource BtnVerde}"
                            Padding="18,8" FontSize="13"
                            Click="BtnConfirmar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>