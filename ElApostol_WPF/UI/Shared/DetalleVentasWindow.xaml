<Window x:Class="ElApostol_WPF.UI.Shared.DetalleVentasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de ventas"
        Width="860" Height="640"
        MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="#F5F5F5"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="BtnPrimario" TargetType="Button">
            <Setter Property="Background"  Value="#2E7D32"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="Medium"/>
            <Setter Property="Padding"     Value="22,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1B5E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnLink" TargetType="Button">
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="6,2">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Expander sin bordes, con flecha propia -->
        <Style x:Key="ExpanderLimpio" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Cursor="Hand" HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="hb" Background="Transparent" Padding="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="flecha" Text="▸" FontSize="13" Foreground="#888"
                                                           VerticalAlignment="Center"/>
                                                <ContentPresenter Grid.Column="1"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="flecha" Property="Text" Value="▾"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="hb" Property="Background" Value="#08000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="contenido" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="contenido" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1B5E20" Padding="20,14">
            <StackPanel>
                <TextBlock x:Name="TxtTitulo" Text="Detalle de ventas"
                           FontSize="16" FontWeight="Medium" Foreground="White"/>
                <TextBlock x:Name="TxtSubtitulo" FontSize="12" Foreground="#B3FFFFFF" Margin="0,1,0,0"/>
            </StackPanel>
        </Border>

        <!-- Resumen -->
        <UniformGrid x:Name="PanelResumen" Grid.Row="1" Rows="1" Columns="5" Margin="20,14,20,10">
            <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="12,9" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Total" FontSize="11" Foreground="#666"/>
                    <TextBlock x:Name="TxtTotal" FontSize="18" FontWeight="SemiBold" Foreground="#1B5E20"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="12,9" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="Ventas" FontSize="11" Foreground="#666"/>
                    <TextBlock x:Name="TxtVentas" FontSize="18" FontWeight="SemiBold" Foreground="#111"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="12,9" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="Efectivo" FontSize="11" Foreground="#666"/>
                    <TextBlock x:Name="TxtEfectivo" FontSize="15" FontWeight="SemiBold" Foreground="#111"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="12,9" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="Transferencia" FontSize="11" Foreground="#666"/>
                    <TextBlock x:Name="TxtTransferencia" FontSize="15" FontWeight="SemiBold" Foreground="#111"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="12,9" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Tarjeta" FontSize="11" Foreground="#666"/>
                    <TextBlock x:Name="TxtTarjeta" FontSize="15" FontWeight="SemiBold" Foreground="#111"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Cuerpo: grupos por empleado → ventas → renglones -->
        <Grid Grid.Row="2" Margin="20,0,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                <Button Style="{StaticResource BtnLink}" Content="Expandir todo" Click="BtnExpandir_Click"/>
                <TextBlock Text="·" Foreground="#BBB" VerticalAlignment="Center"/>
                <Button Style="{StaticResource BtnLink}" Content="Contraer todo" Click="BtnContraer_Click"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ListaGrupos">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Grupo: empleado -->
                            <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0"
                                    BorderThickness="1" Margin="0,0,0,10" Padding="14,10">
                                <Expander Style="{StaticResource ExpanderLimpio}"
                                          IsExpanded="{Binding Expandido, Mode=TwoWay}">
                                    <Expander.Header>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="16" Background="#EAF3DE"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Iniciales}" FontSize="12" FontWeight="Bold"
                                                           Foreground="#27500A"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="SemiBold" Foreground="#111"/>
                                                <TextBlock Text="{Binding Resumen}" FontSize="12" Foreground="#777"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalDisplay}" FontSize="16"
                                                       FontWeight="SemiBold" Foreground="#1B5E20" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Expander.Header>

                                    <ItemsControl ItemsSource="{Binding Ventas}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Venta -->
                                                <Border BorderBrush="#F0F0F0" BorderThickness="0,1,0,0" Padding="0,7">
                                                    <Expander Style="{StaticResource ExpanderLimpio}"
                                                              IsExpanded="{Binding Expandido, Mode=TwoWay}">
                                                        <Expander.Header>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="90"/>
                                                                    <ColumnDefinition Width="50"/>
                                                                    <ColumnDefinition Width="110"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="110"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Comprobante}" FontFamily="Consolas"
                                                                           FontSize="12" Foreground="#444" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Hora}" FontSize="12"
                                                                           Foreground="#444" VerticalAlignment="Center"/>
                                                                <Border Grid.Column="2" CornerRadius="10" Padding="8,2"
                                                                        HorizontalAlignment="Left" Background="{Binding MetodoBg}">
                                                                    <TextBlock Text="{Binding Metodo}" FontSize="11"
                                                                               FontWeight="Medium" Foreground="{Binding MetodoFg}"/>
                                                                </Border>
                                                                <TextBlock Grid.Column="3" Text="{Binding ResumenItems}" FontSize="12"
                                                                           Foreground="#777" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="4" Text="{Binding TotalDisplay}" FontSize="13"
                                                                           FontWeight="SemiBold" Foreground="#111"
                                                                           TextAlignment="Right" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Expander.Header>

                                                        <!-- Renglones -->
                                                        <Border Margin="22,8,0,2" Background="#FAFAFA" CornerRadius="6"
                                                                BorderBrush="#EEEEEE" BorderThickness="1" Padding="12,8">
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="50"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="100"/>
                                                                        <ColumnDefinition Width="100"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="Cant." FontSize="11" Foreground="#999"/>
                                                                    <TextBlock Grid.Column="1" Text="Material" FontSize="11" Foreground="#999"/>
                                                                    <TextBlock Grid.Column="2" Text="Precio u." FontSize="11" Foreground="#999" TextAlignment="Right"/>
                                                                    <TextBlock Grid.Column="3" Text="Subtotal" FontSize="11" Foreground="#999" TextAlignment="Right"/>
                                                                </Grid>
                                                                <ItemsControl ItemsSource="{Binding Lineas}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,3">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="50"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="100"/>
                                                                                    <ColumnDefinition Width="100"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{Binding Cantidad}" FontSize="12" FontWeight="SemiBold" Foreground="#111"/>
                                                                                <TextBlock Grid.Column="1" FontSize="12" Foreground="#222" TextTrimming="CharacterEllipsis">
                                                                                    <Run Text="{Binding Producto, Mode=OneWay}"/>
                                                                                    <Run Text="{Binding Medida, Mode=OneWay}" Foreground="#888"/>
                                                                                </TextBlock>
                                                                                <TextBlock Grid.Column="2" Text="{Binding PrecioDisplay}" FontSize="12" Foreground="#555" TextAlignment="Right"/>
                                                                                <TextBlock Grid.Column="3" Text="{Binding SubtotalDisplay}" FontSize="12" Foreground="#111" TextAlignment="Right"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Text="{Binding RecargoDisplay}" Visibility="{Binding RecargoVisibility}"
                                                                           FontSize="11" Foreground="#854F0B" TextAlignment="Right" Margin="0,4,0,0"/>
                                                                <TextBlock Text="{Binding ObservacionesDisplay}" Visibility="{Binding ObservacionesVisibility}"
                                                                           FontSize="11" FontStyle="Italic" Foreground="#666"
                                                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Expander>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="TxtVacio" Grid.Row="1" Text="Sin ventas registradas."
                       FontSize="14" Foreground="#888"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="White" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock Text="Hacé clic en una venta para ver qué se vendió."
                           FontSize="12" Foreground="#999" VerticalAlignment="Center"/>
                <Button Style="{StaticResource BtnPrimario}" Content="Cerrar"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        IsCancel="True" Click="BtnCerrar_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
