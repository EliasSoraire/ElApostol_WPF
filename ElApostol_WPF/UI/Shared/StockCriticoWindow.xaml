<Window x:Class="ElApostol_WPF.UI.Shared.StockCriticoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stock crítico"
        Width="780" Height="560"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="#F5F5F5"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="BtnPrimario" TargetType="Button">
            <Setter Property="Background"  Value="#2E7D32"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="Medium"/>
            <Setter Property="Padding"     Value="22,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1B5E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1B5E20" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="18" Foreground="#FFD54F"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Stock crítico" FontSize="16" FontWeight="Medium" Foreground="White"/>
                    <TextBlock x:Name="TxtSubtitulo" FontSize="12" Foreground="#B3FFFFFF" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Resumen -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="2" Margin="20,14,20,10">
            <Border Background="White" CornerRadius="8" BorderBrush="#F5C6C6" BorderThickness="1"
                    Padding="14,10" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Sin stock" FontSize="12" Foreground="#791F1F"/>
                    <TextBlock x:Name="TxtSinStock" Text="0" FontSize="22" FontWeight="Medium" Foreground="#A32D2D"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" BorderBrush="#F2D3A0" BorderThickness="1"
                    Padding="14,10" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Bajo el mínimo" FontSize="12" Foreground="#633806"/>
                    <TextBlock x:Name="TxtBajoMinimo" Text="0" FontSize="22" FontWeight="Medium" Foreground="#854F0B"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Tabla -->
        <Border Grid.Row="2" Margin="20,0,20,12" Background="White" CornerRadius="8"
                BorderBrush="#E0E0E0" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#2E7D32" CornerRadius="7,7,0,0" Padding="14,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Código"   Foreground="White" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="Material" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="Medida"   Foreground="White" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Grid.Column="3" Text="Stock"    Foreground="White" FontWeight="Bold" FontSize="12" TextAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="Mínimo"   Foreground="White" FontWeight="Bold" FontSize="12" TextAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="Reponer"  Foreground="White" FontWeight="Bold" FontSize="12" TextAlignment="Center"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ListaCriticos">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="14,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding CodigoInterno}" FontSize="12"
                                                   Foreground="#666" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nombre}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#111" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detalle}" FontSize="11" Foreground="#888"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Medida}" FontSize="12"
                                                   Foreground="#333" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="3" CornerRadius="10" Padding="10,2"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="{Binding BadgeBg}">
                                            <TextBlock Text="{Binding StockActual}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{Binding BadgeFg}"/>
                                        </Border>
                                        <TextBlock Grid.Column="4" Text="{Binding StockMinimo}" FontSize="12"
                                                   Foreground="#666" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Faltante}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#A32D2D"
                                                   TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="TxtVacio" Grid.Row="1"
                           Text="✓ No hay productos con stock crítico"
                           FontSize="14" Foreground="#2E7D32"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="White" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock Text="&quot;Reponer&quot; es lo que falta para llegar al stock mínimo."
                           FontSize="12" Foreground="#999" VerticalAlignment="Center"/>
                <Button Style="{StaticResource BtnPrimario}" Content="Cerrar"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        IsCancel="True" Click="BtnCerrar_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
