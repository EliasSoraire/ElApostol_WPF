<Window x:Class="ElApostol_WPF.UI.Shared.NuevaVentaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="El Apóstol — Nueva Venta"
        Height="600" Width="880"
        MinHeight="540" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#F5F5F5"
        KeyDown="Window_KeyDown">

    <Window.Resources>

        <SolidColorBrush x:Key="Verde"        Color="#2E7D32"/>
        <SolidColorBrush x:Key="VerdeOscuro"  Color="#1B5E20"/>
        <SolidColorBrush x:Key="VerdeLight"   Color="#EAF3DE"/>
        <SolidColorBrush x:Key="VerdeDark"    Color="#27500A"/>
        <SolidColorBrush x:Key="TextPrimary"  Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="BorderColor"  Color="#DDDDDD"/>
        <SolidColorBrush x:Key="BgPrimary"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgSecondary"  Color="#F5F5F5"/>
        <SolidColorBrush x:Key="Naranja"      Color="#FAEEDA"/>
        <SolidColorBrush x:Key="NaranjaFg"    Color="#633806"/>

        <!-- Botón verde principal -->
        <Style x:Key="BtnVerde" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#2E7D32"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón rojo / cancelar -->
        <Style x:Key="BtnRojo" TargetType="Button">
            <Setter Property="Foreground"      Value="#791F1F"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="BorderBrush"     Value="#DDDDDD"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FCEBEB"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#A32D2D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Método de pago card -->
        <Style x:Key="PayCard" TargetType="Border">
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush"     Value="#DDDDDD"/>
            <Setter Property="Background"      Value="#F5F5F5"/>
            <Setter Property="Padding"         Value="10,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="0,0,0,5"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1B5E20">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Nueva venta"
                               FontSize="14" FontWeight="Medium" Foreground="White"/>
                    <TextBlock Text="Agregá los materiales y seleccioná el método de pago"
                               FontSize="11" Foreground="#99FFFFFF"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#C0DD97" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtHeaderUsuario"
                               FontSize="12" Foreground="#BFFFFFFF"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="248"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO -->
            <Grid Grid.Column="0" Margin="12,10,7,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Barra búsqueda -->
                    <RowDefinition Height="Auto"/>
                    <!-- Sugerencias -->
                    <RowDefinition Height="*"/>
                    <!-- Tabla -->
                </Grid.RowDefinitions>

                <!-- Barra búsqueda -->
                <Border Grid.Row="0"
                        Background="White" CornerRadius="7"
                        BorderBrush="#DDDDDD" BorderThickness="0.5"
                        Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Buscar material -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BUSCAR MATERIAL"
                                       FontSize="10" FontWeight="Medium"
                                       Foreground="#888888"
                                       Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtBusqueda"
                                     Height="30" FontSize="12"
                                     Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     Background="#F7F7F7"
                                     BorderBrush="#222222" BorderThickness="1"
                                     TextChanged="TxtBusqueda_TextChanged"
                                     KeyDown="TxtBusqueda_KeyDown"/>
                        </StackPanel>

                        <!-- Variante -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="VARIANTE"
                                       FontSize="10" FontWeight="Medium"
                                       Foreground="#888888"
                                       Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbVariante"
                                      Height="30" FontSize="12"
                                      Background="#F7F7F7"
                                      BorderBrush="#222222"
                                      SelectionChanged="CmbVariante_SelectionChanged"/>
                        </StackPanel>

                        <!-- Cantidad -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="CANTIDAD"
                                       FontSize="10" FontWeight="Medium"
                                       Foreground="#888888"
                                       Margin="0,0,0,3"/>
                            <Border Height="30" CornerRadius="4"
                                    BorderBrush="#222222" BorderThickness="1"
                                    Background="#F7F7F7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="−"
                                            FontSize="15" BorderThickness="0"
                                            Background="Transparent"
                                            Cursor="Hand"
                                            Click="BtnMenos_Click"/>
                                    <TextBox Grid.Column="1"
                                             x:Name="TxtCantidad" Text="1"
                                             FontSize="12" BorderThickness="0"
                                             Background="Transparent"
                                             TextAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             PreviewTextInput="TxtCantidad_PreviewTextInput"/>
                                    <Button Grid.Column="2" Content="+"
                                            FontSize="13" BorderThickness="0"
                                            Background="Transparent"
                                            Cursor="Hand"
                                            Click="BtnMas_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Botón agregar -->
                        <Button Grid.Column="6"
                                x:Name="BtnAgregar"
                                Content="+ Agregar"
                                Style="{StaticResource BtnVerde}"
                                FontSize="12" Padding="12,0"
                                Height="30"
                                VerticalAlignment="Bottom"
                                IsEnabled="False"
                                Click="BtnAgregar_Click"/>
                    </Grid>
                </Border>

                <!-- Sugerencias — estilo HTML con nombre+detalle izq, precio+stock der -->
                <Border Grid.Row="1"
                        x:Name="PanelSugerencias"
                        Visibility="Collapsed"
                        Background="White"
                        CornerRadius="0,0,7,7"
                        BorderBrush="#2E7D32" BorderThickness="1"
                        Margin="0,-1,0,0"
                        MaxHeight="190"
                        Panel.ZIndex="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ListaSugerencias"/>
                    </ScrollViewer>
                </Border>

                <!-- Tabla de ítems -->
                <Border Grid.Row="2"
                        Background="White" CornerRadius="7"
                        BorderBrush="#EEEEEE" BorderThickness="0.5"
                        Margin="0,7,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="DgCarrito"
                                  Grid.Row="0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F0F0"
                                  BorderThickness="0"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FAFAFA"
                                  FontSize="12"
                                  ColumnHeaderHeight="30"
                                  RowHeight="30"
                                  SelectionMode="Single"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False"
                                  HeadersVisibility="Column">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background"  Value="#2E7D32"/>
                                    <Setter Property="Foreground"  Value="White"/>
                                    <Setter Property="FontSize"    Value="11"/>
                                    <Setter Property="FontWeight"  Value="Medium"/>
                                    <Setter Property="Padding"     Value="8,0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código"   Binding="{Binding CodigoInterno}" Width="65"/>
                                <DataGridTextColumn Header="Material" Binding="{Binding NombreProducto}" Width="*"/>
                                <DataGridTextColumn Header="Marca"    Binding="{Binding Marca}"          Width="70"/>
                                <DataGridTextColumn Header="Medida"   Binding="{Binding Medida}"         Width="70"/>
                                <DataGridTextColumn Header="Cant."    Binding="{Binding Cantidad}"       Width="50"/>
                                <DataGridTextColumn Header="P. Unit." Binding="{Binding PrecioDisplay}"  Width="78"/>
                                <DataGridTemplateColumn Header="Subtotal" Width="82">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SubtotalDisplay}"
                                                       FontWeight="Medium"
                                                       Foreground="#1B5E20"
                                                       VerticalAlignment="Center"
                                                       Padding="8,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="36">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕"
                                                    FontSize="12"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    Foreground="#AAAAAA"
                                                    Cursor="Hand"
                                                    Tag="{Binding VarianteId}"
                                                    Click="BtnEliminarItem_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="bg"
                                                                            Background="Transparent"
                                                                            CornerRadius="4"
                                                                            Padding="4,2">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bg" Property="Background" Value="#FCEBEB"/>
                                                                            <Setter Property="Foreground" Value="#791F1F"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>

                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Style.Triggers>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGrid">
                                                        <StackPanel HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,30,0,0">
                                                            <TextBlock Text="◻" FontSize="26"
                                                                       Foreground="#CCCCCC"
                                                                       HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Buscá un material y agregalo a la venta"
                                                                       FontSize="12" Foreground="#AAAAAA"
                                                                       Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                        </DataGrid>

                        <!-- Info cantidad de ítems -->
                        <Border Grid.Row="1"
                                BorderBrush="#EEEEEE" BorderThickness="0,0.5,0,0"
                                Padding="10,5">
                            <TextBlock x:Name="TxtInfoCarrito"
                                       Text="Sin ítems"
                                       FontSize="11" Foreground="#AAAAAA"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- PANEL DERECHO -->
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#DDDDDD" BorderThickness="0.5,0,0,0">
                <Grid Margin="12,10,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Método de pago -->
                        <RowDefinition Height="Auto"/>
                        <!-- Observaciones -->
                        <RowDefinition Height="*"/>
                        <!-- Espaciador -->
                        <RowDefinition Height="Auto"/>
                        <!-- Totales -->
                        <RowDefinition Height="Auto"/>
                        <!-- Botones -->
                    </Grid.RowDefinitions>

                    <!-- Método de pago -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="MÉTODO DE PAGO"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="#888888"
                                   Margin="0,0,0,6"/>

                        <!-- Efectivo -->
                        <Border x:Name="CardEfectivo" Style="{StaticResource PayCard}"
                                MouseLeftButtonDown="PayCard_Click" Tag="efectivo">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="RadioEfectivo"
                                         Grid.Column="0"
                                         Width="13" Height="13"
                                         Stroke="#CCCCCC" StrokeThickness="1.5"
                                         Fill="Transparent"
                                         Margin="0,0,9,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="Efectivo"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="#1A1A1A"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Tarjeta -->
                        <Border x:Name="CardTarjeta" Style="{StaticResource PayCard}"
                                MouseLeftButtonDown="PayCard_Click" Tag="tarjeta">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="RadioTarjeta"
                                         Grid.Column="0"
                                         Width="13" Height="13"
                                         Stroke="#CCCCCC" StrokeThickness="1.5"
                                         Fill="Transparent"
                                         Margin="0,0,9,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="Tarjeta"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="#1A1A1A"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="2"
                                        Background="#FAEEDA" CornerRadius="20"
                                        Padding="7,1">
                                    <TextBlock x:Name="TxtBadgeTarjeta"
                                               Text="+33%"
                                               FontSize="10" Foreground="#633806"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Transferencia -->
                        <Border x:Name="CardTransferencia" Style="{StaticResource PayCard}"
                                MouseLeftButtonDown="PayCard_Click" Tag="transferencia">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="RadioTransferencia"
                                         Grid.Column="0"
                                         Width="13" Height="13"
                                         Stroke="#CCCCCC" StrokeThickness="1.5"
                                         Fill="Transparent"
                                         Margin="0,0,9,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="Transferencia"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="#1A1A1A"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Observaciones -->
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="OBSERVACIONES"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="#888888"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtObservaciones"
                                 Height="58"
                                 FontSize="12"
                                 Padding="9,7"
                                 Background="#F7F7F7"
                                 BorderBrush="#222222" BorderThickness="1"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <!-- Totales -->
                    <Border Grid.Row="3"
                            Background="#F5F5F5" CornerRadius="7"
                            Padding="11">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Subtotal" FontSize="12" Foreground="#666666"/>
                                <TextBlock x:Name="TxtSubtotal"
                                           Text="$0"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="#1A1A1A"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid x:Name="FilaRecargo" Visibility="Collapsed" Margin="0,0,0,4">
                                <TextBlock x:Name="TxtLabelRecargo"
                                           Text="Recargo tarjeta (33%)"
                                           FontSize="12" Foreground="#633806"/>
                                <TextBlock x:Name="TxtRecargo"
                                           Text="$0"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="#633806"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Border BorderBrush="#DDDDDD" BorderThickness="0,0.5,0,0"
                                    Margin="0,3,0,3"/>
                            <Grid>
                                <TextBlock Text="Total"
                                           FontSize="15" FontWeight="Medium"
                                           Foreground="#1B5E20"/>
                                <TextBlock x:Name="TxtTotal"
                                           Text="$0"
                                           FontSize="15" FontWeight="Medium"
                                           Foreground="#1B5E20"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock x:Name="TxtMetodoPagoInfo"
                                       Text="— sin método seleccionado —"
                                       FontSize="11" Foreground="#AAAAAA"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Botones -->
                    <StackPanel Grid.Row="4" Margin="0,9,0,0">
                        <Button x:Name="BtnFinalizar"
                                Content="Finalizar venta"
                                Style="{StaticResource BtnVerde}"
                                FontSize="13" Padding="0,10"
                                IsEnabled="False"
                                Click="BtnFinalizar_Click"
                                Margin="0,0,0,6"/>
                        <Button Content="Cancelar venta"
                                Style="{StaticResource BtnRojo}"
                                Padding="0,7"
                                Click="BtnCancelar_Click"/>
                    </StackPanel>

                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>