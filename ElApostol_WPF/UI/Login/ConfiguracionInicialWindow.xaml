<Window x:Class="ElApostol_WPF.UI.Login.ConfiguracionInicialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración inicial"
        Height="500" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Border Background="White" CornerRadius="10"
            BorderBrush="#DDDDDD" BorderThickness="0.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <Border Grid.Row="0" Background="#1B5E20"
                    CornerRadius="10,10,0,0"
                    Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Configuración inicial"
                               FontSize="15" FontWeight="Medium" Foreground="White"/>
                    <TextBlock Text="Solo se realiza una vez al iniciar el sistema"
                               FontSize="11" Foreground="#A6FFFFFF" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══ STEPPER ═══ -->
            <Border Grid.Row="1" BorderBrush="#EEEEEE" BorderThickness="0,0,0,0.5"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Paso 1 -->
                    <Border x:Name="CircStep1" Grid.Column="0"
                            Width="22" Height="22" CornerRadius="11"
                            Background="#EAF3DE"
                            BorderBrush="#2E7D32" BorderThickness="1.5">
                        <TextBlock x:Name="TxtCirc1" Text="1"
                                   FontSize="11" FontWeight="Medium" Foreground="#27500A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtStep1" Grid.Column="1"
                               Text="Contraseña" FontSize="11" FontWeight="Medium"
                               Foreground="#27500A"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>

                    <!-- Línea 1 -->
                    <Border x:Name="LineStep1" Grid.Column="2"
                            Height="0.5" Background="#DDDDDD"
                            VerticalAlignment="Center" Margin="6,0"/>

                    <!-- Paso 2 -->
                    <Border x:Name="CircStep2" Grid.Column="3"
                            Width="22" Height="22" CornerRadius="11"
                            Background="#F5F5F5"
                            BorderBrush="#DDDDDD" BorderThickness="0.5">
                        <TextBlock x:Name="TxtCirc2" Text="2"
                                   FontSize="11" FontWeight="Medium" Foreground="#AAAAAA"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtStep2" Grid.Column="4"
                               Text="Pregunta secreta" FontSize="11" FontWeight="Medium"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>

                    <!-- Línea 2 -->
                    <Border x:Name="LineStep2" Grid.Column="5"
                            Height="0.5" Background="#DDDDDD"
                            VerticalAlignment="Center" Margin="6,0"/>

                    <!-- Paso 3 -->
                    <Border x:Name="CircStep3" Grid.Column="6"
                            Width="22" Height="22" CornerRadius="11"
                            Background="#F5F5F5"
                            BorderBrush="#DDDDDD" BorderThickness="0.5">
                        <TextBlock x:Name="TxtCirc3" Text="3"
                                   FontSize="11" FontWeight="Medium" Foreground="#AAAAAA"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtStep3" Grid.Column="7"
                               Text="Listo" FontSize="11" FontWeight="Medium"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </Grid>
            </Border>

            <!-- ═══ CONTENIDO POR PASO ═══ -->

            <!-- PASO 1: Nueva contraseña -->
            <StackPanel x:Name="PanelPaso1" Grid.Row="2"
                        Margin="20,18,20,20">

                <TextBlock Text="NUEVA CONTRASEÑA"
                           FontSize="11" FontWeight="Medium"
                           Foreground="#666666" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,6">
                    <PasswordBox x:Name="PbNueva1"
                 Height="34" FontSize="13" Padding="12,0"
                 VerticalContentAlignment="Center"
                 Background="#F5F5F5"
                 BorderBrush="Black" BorderThickness="1"
                 PasswordChanged="Pass1_Changed"/>

                    <TextBox x:Name="TxtNueva1Visible"
             Height="34" FontSize="13" Padding="12,0"
             VerticalContentAlignment="Center"
             Background="#F5F5F5"
             BorderBrush="#DDDDDD" BorderThickness="1"
             Visibility="Collapsed"
             TextChanged="Pass1Txt_Changed"/>

                    <Button x:Name="BtnOjo1"
            Content="👁"
            FontSize="12"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="0,0,8,0"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand"
            Foreground="Black"
            Click="BtnOjo1_Click"/>
                </Grid>

                <!-- 🔥 NUEVO: seguridad contraseña -->
                <TextBlock x:Name="TxtSeguridadPass"
           FontSize="11"
           Margin="0,0,0,8"
           Foreground="#666666"/>

                <TextBlock Text="CONFIRMAR CONTRASEÑA"
                           FontSize="11" FontWeight="Medium"
                           Foreground="#666666" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,6">
                    <PasswordBox x:Name="PbConfirmar1"
                                 Height="34" FontSize="13" Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F5F5F5"
                                 BorderBrush="Black" BorderThickness="1"
                                 PasswordChanged="Pass1_Changed"/>
                    <TextBox x:Name="TxtConfirmar1Visible"
                             Height="34" FontSize="13" Padding="12,0"
                             VerticalContentAlignment="Center"
                             Background="#F5F5F5"
                             BorderBrush="#DDDDDD" BorderThickness="1"
                             Visibility="Collapsed"
                             TextChanged="Pass1Txt_Changed"/>
                    <Button x:Name="BtnOjoCfm1"
                            Content="●" FontSize="11"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" Foreground="Black"
                            Click="BtnOjoCfm1_Click"/>
                </Grid>

                <TextBlock x:Name="TxtMatchPaso1"
                           FontSize="11" Margin="0,0,0,16"
                           Visibility="Collapsed"/>

                <Button x:Name="BtnSiguiente1"
                        Content="Siguiente"
                        Height="38" FontSize="13" FontWeight="Medium"
                        Cursor="Hand" Background="#2E7D32"
                        BorderThickness="0" Foreground="White"
                        IsEnabled="False"
                        Click="BtnSiguiente1_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Background" Value="#DDDDDD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- PASO 2: Pregunta secreta -->
            <StackPanel x:Name="PanelPaso2" Grid.Row="2"
                        Margin="20,18,20,20"
                        Visibility="Collapsed">

                <!-- Caja secreta -->
                <Border Background="#F5F5F5" CornerRadius="8"
                        BorderBrush="#DDDDDD" BorderThickness="0.5"
                        Padding="14,12" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🔒" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Pregunta secreta para recuperar tu cuenta"
                                       FontSize="12" FontWeight="Medium" Foreground="#27500A"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="SELECCIONÁ UNA PREGUNTA"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="#666666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbPregunta"
                                  Height="34" FontSize="12" Padding="10,0"
                                  VerticalContentAlignment="Center"
                                  Background="White"
                                  BorderBrush="#DDDDDD" BorderThickness="1"
                                  Margin="0,0,0,12"
                                  SelectionChanged="CmbPregunta_Changed">
                            <ComboBoxItem Content="Elegí una pregunta..." Tag=""/>
                            <ComboBoxItem Content="¿Nombre de tu primera mascota?" Tag="mascota"/>
                            <ComboBoxItem Content="¿Ciudad donde naciste?" Tag="ciudad"/>
                            <ComboBoxItem Content="¿Nombre de tu escuela primaria?" Tag="escuela"/>
                            <ComboBoxItem Content="¿Apodo de tu infancia?" Tag="apodo"/>
                            <ComboBoxItem Content="¿Marca de tu primer auto?" Tag="auto"/>
                        </ComboBox>

                        <TextBlock Text="TU RESPUESTA"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="#666666" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtRespuesta"
                                 Height="34" FontSize="13" Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="White"
                                 BorderBrush="Black" BorderThickness="1"
                                 TextChanged="TxtRespuesta_Changed"/>
                    </StackPanel>
                </Border>

                <Button x:Name="BtnGuardarPaso2"
                        Content="Guardar y continuar"
                        Height="38" FontSize="13" FontWeight="Medium"
                        Cursor="Hand" Background="#2E7D32"
                        BorderThickness="0" Foreground="White"
                        IsEnabled="False"
                        Margin="0,0,0,8"
                        Click="BtnGuardarPaso2_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Background" Value="#DDDDDD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Volver"
                        Height="34" FontSize="12"
                        Cursor="Hand" Background="Transparent"
                        BorderBrush="#DDDDDD" BorderThickness="0.5"
                        FontWeight="Bold"
                        Foreground="Black"
                        Click="BtnVolverPaso2_Click"/>
            </StackPanel>

            <!-- PASO 3: Éxito -->
            <StackPanel x:Name="PanelPaso3" Grid.Row="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="20" Visibility="Collapsed">

                <Border Width="52" Height="52" CornerRadius="26"
                        Background="#EAF3DE"
                        HorizontalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="✔" FontSize="22" Foreground="#2E7D32"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="¡Configuración completada!"
                           FontSize="16" FontWeight="Medium"
                           Foreground="#1A1A1A" TextAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Tu contraseña y pregunta secreta fueron guardadas.&#xa;Vas a acceder al sistema en unos segundos."
                           FontSize="12" Foreground="#666666"
                           TextAlignment="Center" TextWrapping="Wrap"
                           LineHeight="20" Margin="0,0,0,12"/>
                <TextBlock x:Name="TxtCountdown"
                           FontSize="11" Foreground="#AAAAAA"
                           TextAlignment="Center"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>