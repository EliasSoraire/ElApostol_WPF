<Window x:Class="ElApostol_WPF.UI.Login.RecuperacionContrasenaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recuperar contraseña"
        Height="460" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Border Background="White" CornerRadius="10"
            BorderBrush="#DDDDDD" BorderThickness="0.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <Border Grid.Row="0" Background="#1B5E20"
                    CornerRadius="10,10,0,0"
                    Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Recuperar contraseña"
                               FontSize="15" FontWeight="Medium" Foreground="White"/>
                    <TextBlock Text="Solo disponible para el dueño del sistema"
                               FontSize="11" Foreground="#A6FFFFFF" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══ STEPPER ═══ -->
            <Border Grid.Row="1" BorderBrush="#EEEEEE" BorderThickness="0,0,0,0.5"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="RCirc1" Grid.Column="0"
                            Width="22" Height="22" CornerRadius="11"
                            Background="#EAF3DE"
                            BorderBrush="#2E7D32" BorderThickness="1.5">
                        <TextBlock x:Name="RTxtC1" Text="1"
                                   FontSize="11" FontWeight="Medium" Foreground="#27500A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="RTxtS1" Grid.Column="1"
                               Text="Verificar" FontSize="11" FontWeight="Medium"
                               Foreground="#27500A"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>

                    <Border x:Name="RLine1" Grid.Column="2"
                            Height="0.5" Background="#DDDDDD"
                            VerticalAlignment="Center" Margin="6,0"/>

                    <Border x:Name="RCirc2" Grid.Column="3"
                            Width="22" Height="22" CornerRadius="11"
                            Background="#F5F5F5"
                            BorderBrush="#DDDDDD" BorderThickness="0.5">
                        <TextBlock x:Name="RTxtC2" Text="2"
                                   FontSize="11" FontWeight="Medium" Foreground="#AAAAAA"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="RTxtS2" Grid.Column="4"
                               Text="Nueva contraseña" FontSize="11" FontWeight="Medium"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>

                    <Border x:Name="RLine2" Grid.Column="5"
                            Height="0.5" Background="#DDDDDD"
                            VerticalAlignment="Center" Margin="6,0"/>

                    <Border x:Name="RCirc3" Grid.Column="6"
                            Width="22" Height="22" CornerRadius="11"
                            Background="#F5F5F5"
                            BorderBrush="#DDDDDD" BorderThickness="0.5">
                        <TextBlock x:Name="RTxtC3" Text="3"
                                   FontSize="11" FontWeight="Medium" Foreground="#AAAAAA"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="RTxtS3" Grid.Column="7"
                               Text="Listo" FontSize="11" FontWeight="Medium"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </Grid>
            </Border>

            <!-- PASO 1: Verificar usuario + respuesta secreta -->
            <StackPanel x:Name="RPanelPaso1" Grid.Row="2"
                        Margin="20,18,20,20">

                <TextBlock Text="USUARIO"
                           FontSize="11" FontWeight="Medium"
                           Foreground="#666666" Margin="0,0,0,5"/>
                <TextBox x:Name="RTxtUsuario"
                         Height="34" FontSize="13" Padding="12,0"
                         VerticalContentAlignment="Center"
                         Background="#F5F5F5"
                         BorderBrush="#DDDDDD" BorderThickness="1"
                         Margin="0,0,0,14"
                         TextChanged="RPaso1_Changed"/>

                <!-- Caja pregunta (se muestra tras ingresar usuario) -->
                <Border x:Name="RPanelPregunta"
                        Background="#EAF3DE" CornerRadius="6"
                        BorderBrush="#2E7D32" BorderThickness="0.5"
                        Padding="12,10" Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="PREGUNTA SECRETA"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="#27500A" Margin="0,0,0,5"/>
                        <TextBlock x:Name="RTxtPreguntaMostrada"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="#27500A" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="TU RESPUESTA"
                           FontSize="11" FontWeight="Medium"
                           Foreground="#666666" Margin="0,0,0,5"/>
                <TextBox x:Name="RTxtRespuesta"
                         Height="34" FontSize="13" Padding="12,0"
                         VerticalContentAlignment="Center"
                         Background="#F5F5F5"
                         BorderBrush="#DDDDDD" BorderThickness="1"
                         Margin="0,0,0,6"
                         TextChanged="RPaso1_Changed"/>

                <!-- Error -->
                <TextBlock x:Name="RTxtErrorPaso1"
                           FontSize="11" Foreground="#791F1F"
                           Margin="0,0,0,14"
                           Visibility="Collapsed"/>

                <Button x:Name="RBtnVerificar"
                        Content="Verificar y continuar"
                        Height="38" FontSize="13" FontWeight="Medium"
                        Cursor="Hand" Background="#2E7D32"
                        BorderThickness="0" Foreground="White"
                        IsEnabled="False"
                        Margin="0,0,0,8"
                        Click="RBtnVerificar_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Background" Value="#DDDDDD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Volver al login"
                        Height="34" FontSize="12"
                        Cursor="Hand" Background="Transparent"
                        BorderBrush="#DDDDDD" BorderThickness="0.5"
                        Foreground="#666666"
                        Click="RBtnVolverLogin_Click"/>
            </StackPanel>

            <!-- PASO 2: Nueva contraseña -->
            <StackPanel x:Name="RPanelPaso2" Grid.Row="2"
                        Margin="20,18,20,20"
                        Visibility="Collapsed">

                <TextBlock Text="NUEVA CONTRASEÑA"
                           FontSize="11" FontWeight="Medium"
                           Foreground="#666666" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,14">
                    <PasswordBox x:Name="RPbNueva"
                                 Height="34" FontSize="13" Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F5F5F5"
                                 BorderBrush="#DDDDDD" BorderThickness="1"
                                 PasswordChanged="RPaso2_Changed"/>
                    <TextBox x:Name="RTxtNuevaVisible"
                             Height="34" FontSize="13" Padding="12,0"
                             VerticalContentAlignment="Center"
                             Background="#F5F5F5"
                             BorderBrush="#DDDDDD" BorderThickness="1"
                             Visibility="Collapsed"
                             TextChanged="RPaso2Txt_Changed"/>
                    <Button x:Name="RBtnOjoNueva"
                            Content="●" FontSize="11"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" Foreground="#AAAAAA"
                            Click="RBtnOjoNueva_Click"/>
                </Grid>

                <TextBlock Text="CONFIRMAR CONTRASEÑA"
                           FontSize="11" FontWeight="Medium"
                           Foreground="#666666" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,6">
                    <PasswordBox x:Name="RPbConfirmar"
                                 Height="34" FontSize="13" Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F5F5F5"
                                 BorderBrush="#DDDDDD" BorderThickness="1"
                                 PasswordChanged="RPaso2_Changed"/>
                    <TextBox x:Name="RTxtConfirmarVisible"
                             Height="34" FontSize="13" Padding="12,0"
                             VerticalContentAlignment="Center"
                             Background="#F5F5F5"
                             BorderBrush="#DDDDDD" BorderThickness="1"
                             Visibility="Collapsed"
                             TextChanged="RPaso2Txt_Changed"/>
                    <Button x:Name="RBtnOjoCfm"
                            Content="●" FontSize="11"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" Foreground="#AAAAAA"
                            Click="RBtnOjoCfm_Click"/>
                </Grid>

                <TextBlock x:Name="RTxtMatchPaso2"
                           FontSize="11" Margin="0,0,0,16"
                           Visibility="Collapsed"/>

                <Button x:Name="RBtnGuardarPass"
                        Content="Guardar nueva contraseña"
                        Height="38" FontSize="13" FontWeight="Medium"
                        Cursor="Hand" Background="#2E7D32"
                        BorderThickness="0" Foreground="White"
                        IsEnabled="False"
                        Margin="0,0,0,8"
                        Click="RBtnGuardarPass_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Background" Value="#DDDDDD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Volver"
                        Height="34" FontSize="12"
                        Cursor="Hand" Background="Transparent"
                        BorderBrush="#DDDDDD" BorderThickness="0.5"
                        Foreground="#666666"
                        Click="RBtnVolverPaso2_Click"/>
            </StackPanel>

            <!-- PASO 3: Éxito -->
            <StackPanel x:Name="RPanelPaso3" Grid.Row="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="20" Visibility="Collapsed">

                <Border Width="52" Height="52" CornerRadius="26"
                        Background="#EAF3DE"
                        HorizontalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="✔" FontSize="22" Foreground="#2E7D32"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Contraseña actualizada"
                           FontSize="16" FontWeight="Medium"
                           Foreground="#1A1A1A" TextAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Tu contraseña fue cambiada correctamente.&#xa;Vas a ser redirigido al login en unos segundos."
                           FontSize="12" Foreground="#666666"
                           TextAlignment="Center" TextWrapping="Wrap"
                           LineHeight="20" Margin="0,0,0,12"/>
                <TextBlock x:Name="RTxtCountdown"
                           FontSize="11" Foreground="#AAAAAA"
                           TextAlignment="Center"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>