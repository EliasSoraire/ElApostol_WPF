<Window x:Class="ElApostol_WPF.UI.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="El Apóstol" Height="520" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- Campo de texto redondeado con foco verde -->
        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F7F7F7"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="borde" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="borde" Property="Background" Value="White"/>
                                <Setter TargetName="borde" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="borde" Property="BorderBrush" Value="#2E7D32"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="error">
                                <Setter TargetName="borde" Property="BorderBrush" Value="#D32F2F"/>
                                <Setter TargetName="borde" Property="Background" Value="#FFF8F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CampoPassword" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0,40,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F7F7F7"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="borde" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="borde" Property="Background" Value="White"/>
                                <Setter TargetName="borde" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="borde" Property="BorderBrush" Value="#2E7D32"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="error">
                                <Setter TargetName="borde" Property="BorderBrush" Value="#D32F2F"/>
                                <Setter TargetName="borde" Property="Background" Value="#FFF8F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonVerde" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1B5E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" BorderBrush="#CCCCCC" BorderThickness="0.5" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== PANEL IZQUIERDO ===== -->
            <Border Grid.Column="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#388E3C" Offset="0"/>
                        <GradientStop Color="#1B5E20" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- Círculos decorativos -->
                    <Ellipse Width="220" Height="220" Fill="#0DFFFFFF"
                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-80,-70,0,0"/>
                    <Ellipse Width="160" Height="160" Fill="#0DFFFFFF"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-50,-40"/>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">
                        <Border Width="100" Height="100" CornerRadius="50"
                                Background="#26FFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="2"
                                HorizontalAlignment="Center">
                            <Border Width="70" Height="70" CornerRadius="35" Background="#E5FFFFFF"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="A" FontSize="28" FontWeight="Medium" Foreground="#2E7D32"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>

                        <TextBlock Text="El Apóstol" FontSize="26" FontWeight="Medium"
                                   Foreground="White" TextAlignment="Center" Margin="0,16,0,0"/>

                        <Border Width="40" Height="2" Background="#59FFFFFF" CornerRadius="2"
                                Margin="0,12,0,12" HorizontalAlignment="Center"/>

                        <TextBlock Text="Sistema de gestión integral&#xa;para materiales de construcción"
                                   FontSize="13" Foreground="#BFFFFFFF" TextAlignment="Center" LineHeight="20"/>

                        <Border Background="#1FFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="0.5"
                                CornerRadius="20" Padding="14,4" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <TextBlock Text="v2.0 · Construcción" FontSize="12" Foreground="#CCFFFFFF"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== PANEL DERECHO ===== -->
            <Border Grid.Column="1" Background="White" Padding="44,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center">

                        <!-- Header -->
                        <TextBlock Text="¡Bienvenido!" FontSize="24" FontWeight="SemiBold"
                                   Foreground="#1A1A1A" Margin="0,0,0,4"/>
                        <TextBlock Text="Ingresá con tu usuario y contraseña para continuar."
                                   FontSize="13" Foreground="#666666" TextWrapping="Wrap"
                                   Margin="0,0,0,26"/>

                        <!-- Usuario -->
                        <TextBlock Text="USUARIO" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#666666" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtUsuario" Style="{StaticResource CampoTexto}"
                                 Margin="0,0,0,16" TextChanged="TxtUsuario_TextChanged"/>

                        <!-- Contraseña -->
                        <TextBlock Text="CONTRASEÑA" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#666666" Margin="0,0,0,6"/>
                        <Grid>
                            <PasswordBox x:Name="PbContrasena" Style="{StaticResource CampoPassword}"/>
                            <TextBox x:Name="TxtContrasenaVisible" Style="{StaticResource CampoTexto}"
                                     Padding="12,0,40,0" Visibility="Collapsed"/>
                            <Button x:Name="BtnOjo"
                                    Width="32" Height="32"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,5,0"
                                    Background="Transparent" BorderThickness="0"
                                    Content="●" FontSize="12" Foreground="#AAAAAA"
                                    Cursor="Hand" Focusable="False"
                                    ToolTip="Mostrar / ocultar contraseña"
                                    Click="BtnOjo_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Error -->
                        <Border x:Name="PanelError" Background="#FCEBEB" CornerRadius="6"
                                Padding="10,7" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="TxtError" FontSize="12" Foreground="#A32D2D"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Ingresar -->
                        <Button x:Name="BtnIngresar" Style="{StaticResource BotonVerde}"
                                Height="44" Margin="0,18,0,0" FontSize="14"
                                Content="Ingresar al sistema"
                                Click="BtnIngresar_Click"/>

                        <!-- Recuperación (solo aparece si el dueño falla la contraseña) -->
                        <Border x:Name="PanelRecuperar" Background="#F4F9EF"
                                BorderBrush="#C5DFB0" BorderThickness="1" CornerRadius="8"
                                Padding="12,10" Margin="0,14,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="¿Olvidaste tu contraseña?" FontSize="13"
                                               FontWeight="SemiBold" Foreground="#27500A"/>
                                    <TextBlock Text="Restablecela con tu pregunta de seguridad."
                                               FontSize="11.5" Foreground="#4F6B3A" TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnRecuperar" Grid.Column="1"
                                        Style="{StaticResource BotonVerde}"
                                        Padding="14,7" FontSize="12"
                                        Content="Recuperar"
                                        VerticalAlignment="Center"
                                        Click="BtnRecuperar_Click"/>
                            </Grid>
                        </Border>

                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="v2.0 · Sistema de Construcción"
                               FontSize="11" Foreground="#AAAAAA"
                               HorizontalAlignment="Right" Margin="0,0,0,16"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
