<UserControl x:Class="ElApostol_WPF.UI.Empleado.RegistroCajaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">

    <UserControl.Resources>

        <!-- ── Botón verde ── -->
        <Style x:Key="BtnVerde" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#2E7D32"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Botón de período (pill) ── -->
        <Style x:Key="BtnPeriodo" TargetType="Button">
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="BorderBrush"     Value="#DDDDDD"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#666666"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#EAF3DE"/>
                                <Setter TargetName="bg" Property="BorderBrush"  Value="#2E7D32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill activo -->
        <Style x:Key="BtnPeriodoActivo" TargetType="Button"
               BasedOn="{StaticResource BtnPeriodo}">
            <Setter Property="Background"   Value="#EAF3DE"/>
            <Setter Property="BorderBrush"  Value="#2E7D32"/>
            <Setter Property="Foreground"   Value="#27500A"/>
            <Setter Property="FontWeight"   Value="Medium"/>
        </Style>

        <!-- ── Tarjeta métrica ── -->
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="BorderBrush"     Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding"         Value="14,12"/>
        </Style>

        <!-- ── Botón tabla ── -->
        <Style x:Key="BtnVer" TargetType="Button">
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="BorderBrush"     Value="#DDDDDD"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#666666"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#EAF3DE"/>
                                <Setter TargetName="bg" Property="BorderBrush"  Value="#2E7D32"/>
                                <Setter Property="Foreground" Value="#27500A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top bar          -->
            <RowDefinition Height="Auto"/>
            <!-- Filtro período   -->
            <RowDefinition Height="Auto"/>
            <!-- Tarjetas métricas-->
            <RowDefinition Height="*"/>
            <!-- Tabla            -->
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="18,14,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Mi registro de caja"
                           FontSize="15" FontWeight="Medium"
                           Foreground="#1A1A1A"/>
                <TextBlock Text="Resumen de ventas de tu turno"
                           FontSize="12" Foreground="#888888"
                           Margin="0,1,0,0"/>
            </StackPanel>
            <Button Grid.Column="1"
                    x:Name="BtnExportar"
                    Style="{StaticResource BtnVerde}"
                    FontSize="12" Padding="14,8"
                    Click="BtnExportar_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↓" FontSize="13" Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Exportar cierre de caja PDF"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Fila filtros de período -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="18,10,18,0"
                    VerticalAlignment="Center">
            <TextBlock Text="Ver registros de:"
                       FontSize="12" Foreground="#666666"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <Button x:Name="BtnPeriodoHoy"
                    Content="Hoy"
                    Style="{StaticResource BtnPeriodoActivo}"
                    Padding="12,6"
                    Margin="0,0,4,0"
                    Click="BtnPeriodo_Click" Tag="hoy"/>

            <Button x:Name="BtnPeriodoAyer"
                    Content="Ayer"
                    Style="{StaticResource BtnPeriodo}"
                    Padding="12,6"
                    Margin="0,0,4,0"
                    Click="BtnPeriodo_Click" Tag="ayer"/>

            <Button x:Name="BtnPeriodoSemana"
                    Content="Esta semana"
                    Style="{StaticResource BtnPeriodo}"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Click="BtnPeriodo_Click" Tag="semana"/>

            <DatePicker x:Name="DpFecha"
                        FontSize="12"
                        BorderBrush="#DDDDDD"
                        Background="White"
                        SelectedDateChanged="DpFecha_SelectedDateChanged"
                        Width="130"/>
        </StackPanel>

        <!-- Tarjetas métricas -->
        <Grid Grid.Row="2" Margin="18,10,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total recaudado -->
            <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="Total recaudado"
                               FontSize="11" Foreground="#666666"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtTotalRecaudado"
                               Text="$0"
                               FontSize="18" FontWeight="Medium"
                               Foreground="#1B5E20"/>
                    <TextBlock x:Name="TxtSubTotalRecaudado"
                               Text="0 ventas del período"
                               FontSize="11" Foreground="#AAAAAA"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Efectivo -->
            <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="Efectivo"
                               FontSize="11" Foreground="#666666"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtTotalEfectivo"
                               Text="$0"
                               FontSize="18" FontWeight="Medium"
                               Foreground="#1A1A1A"/>
                    <TextBlock x:Name="TxtSubEfectivo"
                               Text="0 transacciones"
                               FontSize="11" Foreground="#AAAAAA"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta -->
            <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="Tarjeta de crédito"
                               FontSize="11" Foreground="#666666"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtTotalTarjeta"
                               Text="$0"
                               FontSize="18" FontWeight="Medium"
                               Foreground="#1A1A1A"/>
                    <TextBlock x:Name="TxtSubTarjeta"
                               Text="0 transacciones · con recargo"
                               FontSize="11" Foreground="#AAAAAA"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Transferencia -->
            <Border Grid.Column="6" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="Transferencia"
                               FontSize="11" Foreground="#666666"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtTotalTransferencia"
                               Text="$0"
                               FontSize="18" FontWeight="Medium"
                               Foreground="#1A1A1A"/>
                    <TextBlock x:Name="TxtSubTransferencia"
                               Text="0 transacciones"
                               FontSize="11" Foreground="#AAAAAA"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ─── TABLA DE VENTAS ─── -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="8"
                BorderBrush="#EEEEEE" BorderThickness="0.5"
                Margin="18,10,18,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Encabezado sección -->
                    <RowDefinition Height="*"/>
                    <!-- DataGrid           -->
                    <RowDefinition Height="Auto"/>
                    <!-- Paginación         -->
                </Grid.RowDefinitions>

                <!-- Título sección tabla -->
                <Border Grid.Row="0"
                        BorderBrush="#EEEEEE" BorderThickness="0,0,0,0.5"
                        Padding="14,10">
                    <Grid>
                        <TextBlock Text="Detalle de ventas"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="#1A1A1A"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtConteoVentas"
                                   Text="0 ventas registradas"
                                   FontSize="12" Foreground="#888888"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1"
                          x:Name="DgVentas"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F0F0"
                          BorderThickness="0"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFAFA"
                          FontSize="12"
                          ColumnHeaderHeight="34"
                          RowHeight="34"
                          SelectionMode="Single"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"  Value="#2E7D32"/>
                            <Setter Property="Foreground"  Value="White"/>
                            <Setter Property="FontSize"    Value="11"/>
                            <Setter Property="FontWeight"  Value="Bold"/>
                            <Setter Property="Padding"     Value="10,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <!-- Comprobante -->
                        <DataGridTextColumn Header="#"
                                            Binding="{Binding NumeroComprobante}"
                                            Width="Auto" MinWidth="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#000000"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Hora -->
                        <DataGridTextColumn Header="Hora"
                                            Binding="{Binding HoraDisplay}"
                                            Width="Auto" MinWidth="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#000000"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Material (primer ítem) -->
                        <DataGridTextColumn Header="Material"
                                            Binding="{Binding PrimerMaterial}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#000000"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Medida -->
                        <DataGridTextColumn Header="Medida"
                                            Binding="{Binding MedidaDisplay}"
                                            Width="Auto" MinWidth="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#000000"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cantidad ítems -->
                        <DataGridTextColumn Header="Cant."
                                            Binding="{Binding CantidadItems}"
                                            Width="Auto" MinWidth="55">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#000000"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Total -->
                        <DataGridTemplateColumn Header="Total" Width="Auto" MinWidth="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalDisplay}"
                                               FontWeight="Bold"
                                               Foreground="#1B5E20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Padding="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Método de pago (badge) -->
                        <DataGridTemplateColumn Header="Método" Width="Auto" MinWidth="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="BadgeMetodo"
                                            CornerRadius="20"
                                            Padding="8,2"
                                            HorizontalAlignment="Center"
                                            Margin="10,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#EAF3DE"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MetodoPago}" Value="tarjeta">
                                                        <Setter Property="Background" Value="#FAEEDA"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MetodoPago}" Value="transferencia">
                                                        <Setter Property="Background" Value="#E6F1FB"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding MetodoPagoDisplay}"
                                                   FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#27500A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MetodoPago}" Value="tarjeta">
                                                            <Setter Property="Foreground" Value="#633806"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MetodoPago}" Value="transferencia">
                                                            <Setter Property="Foreground" Value="#0C447C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Botón Ver -->
                        <DataGridTemplateColumn Header="Comp." Width="Auto" MinWidth="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Ver"
                                            Style="{StaticResource BtnVer}"
                                            Padding="10,3"
                                            HorizontalAlignment="Center"
                                            Tag="{Binding VentaId}"
                                            Click="BtnVerDetalle_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <!-- Estado vacío -->
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGrid">
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="0,40,0,0">
                                                    <TextBlock Text="◻" FontSize="28"
                                                               Foreground="#CCCCCC"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="No hay ventas registradas en este período"
                                                               FontSize="13" Foreground="#AAAAAA"
                                                               Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                </DataGrid>

                <!-- Paginación -->
                <Border Grid.Row="2"
                        BorderBrush="#EEEEEE" BorderThickness="0,0.5,0,0"
                        Padding="12,9">
                    <Grid>
                        <TextBlock x:Name="TxtPaginaInfo"
                                   FontSize="12" Foreground="#888888"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button x:Name="BtnPagAnt"
                                    Content="Ant."
                                    Style="{StaticResource BtnVer}"
                                    Padding="9,4"
                                    Margin="0,0,4,0"
                                    IsEnabled="False"
                                    Click="BtnPagAnt_Click"/>
                            <Border x:Name="BadgePagina"
                                    Background="#2E7D32"
                                    CornerRadius="4"
                                    Padding="9,4">
                                <TextBlock x:Name="TxtPaginaActual"
                                           Text="1"
                                           FontSize="12" Foreground="White"/>
                            </Border>
                            <Button x:Name="BtnPagSig"
                                    Content="Sig."
                                    Style="{StaticResource BtnVer}"
                                    Padding="9,4"
                                    Margin="4,0,0,0"
                                    IsEnabled="False"
                                    Click="BtnPagSig_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
