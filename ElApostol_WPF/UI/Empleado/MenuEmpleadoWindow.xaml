<Window x:Class="ElApostol_WPF.UI.Empleado.MenuEmpleadoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="El Apóstol — Empleado"
        Height="680" Width="960"
        MinHeight="680" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#F2F2F2"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Colores -->
        <SolidColorBrush x:Key="SidebarBg"         Color="#1B5E20"/>
        <SolidColorBrush x:Key="SidebarAccent"     Color="#2E7D32"/>
        <SolidColorBrush x:Key="StockOkBg"         Color="#EAF3DE"/>
        <SolidColorBrush x:Key="StockOkFg"         Color="#27500A"/>
        <SolidColorBrush x:Key="StockLowBg"        Color="#FAEEDA"/>
        <SolidColorBrush x:Key="StockLowFg"        Color="#633806"/>
        <SolidColorBrush x:Key="StockCritBg"       Color="#FCEBEB"/>
        <SolidColorBrush x:Key="StockCritFg"       Color="#791F1F"/>

        <!-- Estilo botón sidebar -->
        <Style x:Key="SbBtn" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="Medium"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Padding"      Value="10,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón sidebar activo -->
        <Style x:Key="SbBtnActive" TargetType="Button" BasedOn="{StaticResource SbBtn}">
            <Setter Property="Background" Value="#2EFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Botón cerrar sesión -->
        <Style x:Key="SbLogout" TargetType="Button">
            <Setter Property="Background"   Value="#33DC3545"/>
            <Setter Property="Foreground"   Value="#FFB3B3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="Medium"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Padding"      Value="10,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón Nueva Venta (verde) -->
        <Style x:Key="BtnNuevaVenta" TargetType="Button">
            <Setter Property="Background"      Value="#2E7D32"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón Vender (fila tabla) -->
        <Style x:Key="BtnVender" TargetType="Button">
            <Setter Property="Background"      Value="#EAF3DE"/>
            <Setter Property="Foreground"      Value="#27500A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E7D32"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#E8E8E8"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón paginación -->
        <Style x:Key="PagBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#666"/>
            <Setter Property="BorderBrush"     Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="9,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PagBtnActive" TargetType="Button" BasedOn="{StaticResource PagBtn}">
            <Setter Property="Background"  Value="#2E7D32"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
        </Style>

        <!-- TextBox buscar -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#222"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox categoría -->
        <Style x:Key="CatCombo" TargetType="ComboBox">
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#222"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="Height"          Value="34"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════ SIDEBAR ══════════════ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
            <DockPanel>

                <!-- Header usuario -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,0.5"
                        Padding="14,16,14,12">
                    <StackPanel>
                        <Border Width="38" Height="38" CornerRadius="19"
                                Background="#26FFFFFF" HorizontalAlignment="Left">
                            <TextBlock x:Name="TxtAvatarIniciales"
                                       Foreground="White" FontSize="13" FontWeight="Medium"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtNombreCompleto"
                                   Foreground="White" FontSize="13" FontWeight="Medium"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="Vendedor/a · Empleado/a"
                                   Foreground="#99FFFFFF" FontSize="11" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta turno -->
                <Border DockPanel.Dock="Top" Margin="8,10"
                        Background="#14FFFFFF" CornerRadius="8"
                        BorderBrush="#1FFFFFFF" BorderThickness="0.5"
                        Padding="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#C0DD97" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="TURNO ACTIVO" Foreground="#80FFFFFF" FontSize="10"
                                       VerticalAlignment="Center" FontWeight="Medium"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtReloj"
                                   Foreground="White" FontSize="16" FontWeight="Medium"
                                   FontFamily="Consolas" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtIngresaste"
                                   Foreground="#8CFFFFFF" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Footer cerrar sesión -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="#1FFFFFFF" BorderThickness="0,0.5,0,0"
                        Padding="8,10">
                    <Button Style="{StaticResource SbLogout}" Click="BtnCerrarSesion_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Path Data="M6 2H3a1 1 0 00-1 1v10a1 1 0 001 1h3M11 11l3-3-3-3M14 8H6"
                                  Stroke="#FFB3B3" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Cerrar sesión · F12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Navegación -->
                <StackPanel Margin="8,4">
                    <TextBlock Text="ACCIONES" Foreground="#66FFFFFF" FontSize="10"
                               FontWeight="Medium" Margin="8,8,8,4"/>

                    <!-- Inventario (activo) -->
                    <Button x:Name="BtnNavInventario"
                            Style="{StaticResource SbBtnActive}"
                            Click="BtnNavInventario_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <Path Data="M1 1h6v6H1zM9 1h6v6H9zM1 9h6v6H1zM9 9h6v6H9z"
                                      Fill="White" Opacity="0.7"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Inventario" VerticalAlignment="Center" Foreground="White"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1FFFFFFF" CornerRadius="4" Padding="5,1">
                                <TextBlock Text="F1" FontSize="10" Foreground="#80FFFFFF"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Nueva Venta -->
                    <Button x:Name="BtnNavNuevaVenta"
                            Style="{StaticResource SbBtn}"
                            Click="BtnNavNuevaVenta_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <Path Data="M2 4h12M2 8h8M2 12h5"
                                      Stroke="#D9D9D9" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Nueva venta" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1FFFFFFF" CornerRadius="4" Padding="5,1">
                                <TextBlock Text="F2" FontSize="10" Foreground="#80FFFFFF"/>
                            </Border>
                        </Grid>
                    </Button>

                    <TextBlock Text="REPORTES" Foreground="#66FFFFFF" FontSize="10"
                               FontWeight="Medium" Margin="8,8,8,4"/>

                    <!-- Mi registro de caja -->
                    <Button x:Name="BtnNavRegistroCaja"
                            Style="{StaticResource SbBtn}"
                            Click="BtnNavRegistroCaja_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <Path Data="M2 2h12v12H2zM5 8h6M5 11h4"
                                      Stroke="#D9D9D9" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Mi registro de caja" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1FFFFFFF" CornerRadius="4" Padding="5,1">
                                <TextBlock Text="F3" FontSize="10" Foreground="#80FFFFFF"/>
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════════ CONTENIDO PRINCIPAL ══════════════ -->
        <DockPanel Grid.Column="1">

            <!-- Top bar -->
            <Border DockPanel.Dock="Top" Padding="18,14,18,0">
                <Grid>
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Inventario de materiales"
                                   FontSize="15" FontWeight="Medium" Foreground="#111"/>
                        <TextBlock Text="Consultá el stock y registrá ventas"
                                   FontSize="12" Foreground="#666" Margin="0,1,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtFechaHoy"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="12" Foreground="#999"/>
                </Grid>
            </Border>

            <!-- Tarjetas resumen -->
            <Grid DockPanel.Dock="Top" Margin="18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ventas hoy -->
                <Border Grid.Column="0" Background="White" CornerRadius="8"
                        BorderBrush="#E0E0E0" BorderThickness="0.5" Padding="14,12" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="Ventas hoy" FontSize="11" Foreground="#666"/>
                        <TextBlock x:Name="TxtVentasHoy" FontSize="20" FontWeight="Medium"
                                   Foreground="#1B5E20" Margin="0,4,0,0"/>
                        <TextBlock Text="realizadas en tu turno" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Total recaudado -->
                <Border Grid.Column="1" Background="White" CornerRadius="8"
                        BorderBrush="#E0E0E0" BorderThickness="0.5" Padding="14,12" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="Total recaudado" FontSize="11" Foreground="#666"/>
                        <TextBlock x:Name="TxtTotalRecaudado" FontSize="20" FontWeight="Medium"
                                   Foreground="#111" Margin="0,4,0,0"/>
                        <TextBlock Text="en tu turno de hoy" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Última venta -->
                <Border Grid.Column="2" Background="White" CornerRadius="8"
                        BorderBrush="#E0E0E0" BorderThickness="0.5" Padding="14,12" Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Última venta" FontSize="11" Foreground="#666"/>
                        <TextBlock x:Name="TxtUltimaVentaHora" FontSize="20" FontWeight="Medium"
                                   Foreground="#111" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtUltimaVentaDesc" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Alerta stock crítico -->
            <Border x:Name="AlertaBanner"
                    DockPanel.Dock="Top"
                    Margin="18,0,18,8"
                    Background="#FAEEDA" CornerRadius="8"
                    BorderBrush="#EF9F27" BorderThickness="0.5"
                    Padding="12,8" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M8 2L14 13H2L8 2z M8 7v3 M8 11.5"
                          Stroke="#854F0B" StrokeThickness="1.5"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round"
                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"
                          VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtAlerta"
                               FontSize="12" Foreground="#633806"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Área inventario -->
            <DockPanel Margin="18,0,18,14">

                <!-- Toolbar búsqueda -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtBuscar"
                             Grid.Column="0"
                             Style="{StaticResource SearchBox}"
                             Margin="0,0,8,0"
                             TextChanged="TxtBuscar_TextChanged">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <!-- Placeholder manual -->
                    <TextBlock IsHitTestVisible="False" Text="Buscar por nombre, código o categoría..."
                               Foreground="#AAAAAA" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Grid.Column="0">
                    </TextBlock>

                    <ComboBox x:Name="CmbCategoria"
                              Grid.Column="1"
                              Style="{StaticResource CatCombo}"
                              Margin="0,0,8,0"
                              SelectionChanged="CmbCategoria_SelectionChanged"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource BtnNuevaVenta}"
                            Content="+ Nueva venta"
                            Click="BtnNuevaVenta_Click"/>
                </Grid>

                <!-- Tabla -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#E0E0E0" BorderThickness="0.5"
                        ClipToBounds="True">
                    <DockPanel>

                        <!-- Paginación abajo -->
                        <Border DockPanel.Dock="Bottom"
                                BorderBrush="#E0E0E0" BorderThickness="0,0.5,0,0"
                                Padding="12,9">
                            <Grid>
                                <TextBlock x:Name="TxtPaginacionInfo"
                                           FontSize="12" Foreground="#666"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            x:Name="PanelPagBtns"/>
                            </Grid>
                        </Border>

                        <!-- ListView como tabla -->
                        <ListView x:Name="ListaInventario"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  GridViewColumnHeader.Click="GridHeader_Click">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Código"   Width="70"
                                                    DisplayMemberBinding="{Binding CodigoInterno}"/>
                                    <GridViewColumn Header="Material" Width="165"
                                                    DisplayMemberBinding="{Binding Nombre}"/>
                                    <GridViewColumn Header="Marca"    Width="80"
                                                    DisplayMemberBinding="{Binding Marca}"/>
                                    <GridViewColumn Header="Precio"   Width="75">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PrecioDisplay}"
                                                           Foreground="#111" FontSize="12"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Categoría" Width="90"
                                                    DisplayMemberBinding="{Binding NombreCategoria}"/>
                                    <GridViewColumn Header="Medida"   Width="70"
                                                    DisplayMemberBinding="{Binding Medida}"/>
                                    <GridViewColumn Header="Stock"    Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="StockBadge" CornerRadius="10"
                                                        Padding="8,2" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="StockTxt"
                                                               FontSize="11" FontWeight="Medium"/>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding StockEstado}" Value="ok">
                                                        <Setter TargetName="StockBadge" Property="Background" Value="#EAF3DE"/>
                                                        <Setter TargetName="StockTxt"   Property="Foreground" Value="#27500A"/>
                                                        <Setter TargetName="StockTxt"   Property="Text"       Value="{Binding StockActual}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StockEstado}" Value="low">
                                                        <Setter TargetName="StockBadge" Property="Background" Value="#FAEEDA"/>
                                                        <Setter TargetName="StockTxt"   Property="Foreground" Value="#633806"/>
                                                        <Setter TargetName="StockTxt"   Property="Text"       Value="{Binding StockActual}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StockEstado}" Value="crit">
                                                        <Setter TargetName="StockBadge" Property="Background" Value="#FCEBEB"/>
                                                        <Setter TargetName="StockTxt"   Property="Foreground" Value="#791F1F"/>
                                                        <Setter TargetName="StockTxt"   Property="Text"       Value="{Binding StockActual}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Acción" Width="75">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource BtnVender}"
                                                        Content="{Binding AccionLabel}"
                                                        IsEnabled="{Binding TieneStock}"
                                                        Tag="{Binding}"
                                                        Click="BtnVender_Click"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>

                            <!-- Header verde -->
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background"  Value="#2E7D32"/>
                                    <Setter Property="Foreground"  Value="White"/>
                                    <Setter Property="FontSize"    Value="11"/>
                                    <Setter Property="FontWeight"  Value="Medium"/>
                                    <Setter Property="Padding"     Value="10,9"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GridViewColumnHeader">
                                                <Border Background="#2E7D32" Padding="{TemplateBinding Padding}">
                                                    <TextBlock Text="{TemplateBinding Content}"
                                                               Foreground="White" FontSize="11" FontWeight="Medium"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="BorderBrush"     Value="#E8E8E8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
                                    <Setter Property="Padding"         Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F5F5F5"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#F0F8EE"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.Resources>
                        </ListView>
                    </DockPanel>
                </Border>
            </DockPanel>
        </DockPanel>
    </Grid>
</Window>