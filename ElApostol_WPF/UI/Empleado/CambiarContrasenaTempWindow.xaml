<Window x:Class="ElApostol_WPF.UI.Empleado.CambiarContrasenaTempWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambiar contraseña"
        Height="530" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Border Background="White" CornerRadius="10"
            BorderBrush="#DDDDDD" BorderThickness="0.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <Border Grid.Row="0" Background="#1B5E20"
                    CornerRadius="10,10,0,0"
                    Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Cambiar tu contraseña"
                               FontSize="15" FontWeight="Medium" Foreground="White"/>
                    <TextBlock Text="Requerido antes de continuar al sistema"
                               FontSize="11" Foreground="#A6FFFFFF" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══ BODY ═══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,18,20,0">

                    <!-- Advertencia -->
                    <Border Background="#FAEEDA" CornerRadius="6"
                            BorderBrush="#EF9F27" BorderThickness="0.5"
                            Padding="12,10" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="13" Foreground="#854F0B"
                                       Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock Text="Tu contraseña es temporal. Elegí una nueva para poder acceder al sistema."
                                       FontSize="12" Foreground="#633806"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Info empleado -->
                    <Border Background="#F5F5F5" CornerRadius="8"
                            BorderBrush="Black" BorderThickness="0.5"
                            Padding="12,10" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="17"
                                    Background="#EAF3DE" Margin="0,0,10,0">
                                <TextBlock x:Name="TxtAvatar"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="#27500A"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtNombreEmpleado"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="#1A1A1A"/>
                                <TextBlock x:Name="TxtMetaEmpleado"
                                           FontSize="11" Foreground="#666666"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Separador -->
                    <Border BorderBrush="#EEEEEE" BorderThickness="0,0.5,0,0" Margin="0,0,0,14"/>

                    <!-- Contraseña temporal actual -->
                    <TextBlock Text="CONTRASEÑA TEMPORAL ACTUAL"
                               FontSize="11" FontWeight="Medium"
                               Foreground="#666666" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,14">
                        <PasswordBox x:Name="PbActual"
                                     Height="34" FontSize="13" Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     Background="#D3D3D3"
                                     BorderBrush="Black" BorderThickness="1"
                                     PasswordChanged="Pass_Changed"/>
                        <TextBox x:Name="TxtActualVisible"
                                 Height="34" FontSize="13" Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F5F5F5"
                                 BorderBrush="#DDDDDD" BorderThickness="1"
                                 Visibility="Collapsed"
                                 TextChanged="TxtVisible_Changed"/>
                        <Button x:Name="BtnOjoActual"
                                Content="●" FontSize="11"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Foreground="#AAAAAA"
                                Click="BtnOjoActual_Click"/>
                    </Grid>

                    <!-- Nueva contraseña -->
                    <TextBlock Text="NUEVA CONTRASEÑA"
                               FontSize="11" FontWeight="Medium"
                               Foreground="#666666" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,6">
                        <PasswordBox x:Name="PbNueva"
                                     Height="34" FontSize="13" Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     Background="#D3D3D3"
                                     BorderBrush="Black" BorderThickness="1"
                                     PasswordChanged="Pass_Changed"/>
                        <TextBox x:Name="TxtNuevaVisible"
                                 Height="34" FontSize="13" Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F5F5F5"
                                 BorderBrush="#DDDDDD" BorderThickness="1"
                                 Visibility="Collapsed"
                                 TextChanged="TxtVisible_Changed"/>
                        <Button x:Name="BtnOjoNueva"
                                Content="●" FontSize="11"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Foreground="#AAAAAA"
                                Click="BtnOjoNueva_Click"/>
                    </Grid>

                    <!-- Barra de fortaleza -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BarFuerza1" Grid.Column="0"
                                Height="4" CornerRadius="2"
                                Background="#DDDDDD" Margin="0,0,3,0"/>
                        <Border x:Name="BarFuerza2" Grid.Column="1"
                                Height="4" CornerRadius="2"
                                Background="#DDDDDD" Margin="3,0,3,0"/>
                        <Border x:Name="BarFuerza3" Grid.Column="2"
                                Height="4" CornerRadius="2"
                                Background="#DDDDDD" Margin="3,0,0,0"/>
                    </Grid>
                    <TextBlock x:Name="TxtFuerza"
                               FontSize="11" Foreground="#AAAAAA"
                               Margin="0,-10,0,14"/>

                    <!-- Confirmar contraseña -->
                    <TextBlock Text="CONFIRMAR NUEVA CONTRASEÑA"
                               FontSize="11" FontWeight="Medium"
                               Foreground="#666666" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,6">
                        <PasswordBox x:Name="PbConfirmar"
                                     Height="34" FontSize="13" Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     Background="#D3D3D3"
                                     BorderBrush="Black" BorderThickness="1"
                                     PasswordChanged="Pass_Changed"/>
                        <TextBox x:Name="TxtConfirmarVisible"
                                 Height="34" FontSize="13" Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F5F5F5"
                                 BorderBrush="#DDDDDD" BorderThickness="1"
                                 Visibility="Collapsed"
                                 TextChanged="TxtVisible_Changed"/>
                        <Button x:Name="BtnOjoConfirmar"
                                Content="●" FontSize="11"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Foreground="#AAAAAA"
                                Click="BtnOjoConfirmar_Click"/>
                    </Grid>

                    <!-- Hint coincidencia -->
                    <TextBlock x:Name="TxtMatchHint"
                               FontSize="11" Margin="0,0,0,16"
                               Visibility="Collapsed"/>

                </StackPanel>
            </ScrollViewer>

            <!-- ═══ FOOTER ═══ -->
            <Border Grid.Row="2" BorderBrush="#EEEEEE" BorderThickness="0,0.5,0,0"
                    Padding="20,12">
                <Button x:Name="BtnGuardar"
                        Content="Guardar y continuar"
                        Height="38" FontSize="13" FontWeight="Medium"
                        Cursor="Hand" Background="#2E7D32"
                        BorderThickness="0" Foreground="White"
                        IsEnabled="False"
                        Click="BtnGuardar_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Background" Value="#DDDDDD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>