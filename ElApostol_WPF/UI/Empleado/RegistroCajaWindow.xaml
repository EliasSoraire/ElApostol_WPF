<Window x:Class="ElApostol_WPF.UI.Empleado.RegistroCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="El Apóstol — Mi Registro de Caja"
        Height="700" Width="980"
        MinHeight="620" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#F5F5F5">

    <Window.Resources>

        <!-- ── Colores ── -->
        <SolidColorBrush x:Key="Verde"        Color="#2E7D32"/>
        <SolidColorBrush x:Key="VerdeOscuro"  Color="#1B5E20"/>
        <SolidColorBrush x:Key="VerdeLight"   Color="#EAF3DE"/>
        <SolidColorBrush x:Key="VerdeDark"    Color="#27500A"/>
        <SolidColorBrush x:Key="TextPrimary"  Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextSecond"   Color="#666666"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#888888"/>
        <SolidColorBrush x:Key="BorderColor"  Color="#DDDDDD"/>
        <SolidColorBrush x:Key="BgPrimary"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgSecondary"  Color="#F5F5F5"/>

        <!-- ── Botón verde ── -->
        <Style x:Key="BtnVerde" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#2E7D32"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Botón de período (pill) ── -->
        <Style x:Key="BtnPeriodo" TargetType="Button">
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="BorderBrush"     Value="#DDDDDD"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#666666"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#EAF3DE"/>
                                <Setter TargetName="bg" Property="BorderBrush"  Value="#2E7D32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill activo -->
        <Style x:Key="BtnPeriodoActivo" TargetType="Button"
               BasedOn="{StaticResource BtnPeriodo}">
            <Setter Property="Background"   Value="#EAF3DE"/>
            <Setter Property="BorderBrush"  Value="#2E7D32"/>
            <Setter Property="Foreground"   Value="#27500A"/>
            <Setter Property="FontWeight"   Value="Medium"/>
        </Style>

        <!-- ── Nav sidebar ── -->
        <Style x:Key="SbBtn" TargetType="Button">
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#D9FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav activo -->
        <Style x:Key="SbBtnActivo" TargetType="Button"
               BasedOn="{StaticResource SbBtn}">
            <Setter Property="Background" Value="#2DFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ── Tarjeta métrica ── -->
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="BorderBrush"     Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding"         Value="14,12"/>
        </Style>

        <!-- ── Botón tabla ── -->
        <Style x:Key="BtnVer" TargetType="Button">
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="BorderBrush"     Value="#DDDDDD"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#666666"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#EAF3DE"/>
                                <Setter TargetName="bg" Property="BorderBrush"  Value="#2E7D32"/>
                                <Setter Property="Foreground" Value="#27500A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Layout raíz: sidebar + contenido principal -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════
             SIDEBAR
        ═══════════════════════════════════════ -->
        <Border Grid.Column="0" Background="#1B5E20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Avatar + nombre   -->
                    <RowDefinition Height="Auto"/>
                    <!-- Tarjeta turno     -->
                    <RowDefinition Height="*"/>
                    <!-- Navegación        -->
                    <RowDefinition Height="Auto"/>
                    <!-- Footer logout     -->
                </Grid.RowDefinitions>

                <!-- Avatar + nombre -->
                <Border Grid.Row="0"
                        BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,0.5"
                        Padding="14,16,14,12">
                    <StackPanel>
                        <Border Width="38" Height="38"
                                CornerRadius="19"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8">
                            <Border.Background>
                                <SolidColorBrush Color="#26FFFFFF"/>
                            </Border.Background>
                            <TextBlock x:Name="TxtAvatar"
                                       FontSize="13" FontWeight="Medium"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtSbNombre"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="White"/>
                        <TextBlock Text="Vendedor · Empleado"
                                   FontSize="11"
                                   Foreground="#99FFFFFF"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta turno activo -->
                <Border Grid.Row="1"
                        Background="#14FFFFFF"
                        CornerRadius="8"
                        BorderBrush="#1AFFFFFF" BorderThickness="0.5"
                        Margin="8,10,8,0"
                        Padding="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="6" Height="6" Fill="#C0DD97"
                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="TURNO ACTIVO"
                                       FontSize="10" Foreground="#80FFFFFF"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtReloj"
                                   FontSize="20" FontWeight="Medium"
                                   Foreground="White"/>
                        <TextBlock x:Name="TxtTurnoDesde"
                                   FontSize="11" Foreground="#80FFFFFF"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Navegación -->
                <StackPanel Grid.Row="2" Margin="8,8,8,0">
                    <TextBlock Text="ACCIONES"
                               FontSize="10" Foreground="#66FFFFFF"
                               Margin="8,8,0,4"/>

                    <!-- Inventario -->
                    <Button Style="{StaticResource SbBtn}"
                            Padding="10,9"
                            Click="BtnSbInventario_Click">
                        <Grid Width="164">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Path Width="14" Height="14"
                                      Data="M1,1 h6 v6 h-6 Z M9,1 h6 v6 h-6 Z M1,9 h6 v6 h-6 Z M9,9 h6 v6 h-6 Z"
                                      Fill="#CCFFFFff" Margin="0,0,8,0"
                                      Stretch="Uniform"/>
                                <TextBlock Text="Inventario" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#1AFFFFFF" CornerRadius="4"
                                    Padding="5,1">
                                <TextBlock Text="F1" FontSize="10"
                                           Foreground="#80FFFFFF"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Nueva venta -->
                    <Button Style="{StaticResource SbBtn}"
                            Padding="10,9"
                            Click="BtnSbNuevaVenta_Click">
                        <Grid Width="164">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nueva venta"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    Background="#1AFFFFFF" CornerRadius="4"
                                    Padding="5,1">
                                <TextBlock Text="F2" FontSize="10"
                                           Foreground="#80FFFFFF"/>
                            </Border>
                        </Grid>
                    </Button>

                    <TextBlock Text="REPORTES"
                               FontSize="10" Foreground="#66FFFFFF"
                               Margin="8,12,0,4"/>

                    <!-- Mi registro (activo) -->
                    <Button Style="{StaticResource SbBtnActivo}"
                            Padding="10,9">
                        <Grid Width="164">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mi registro de caja"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    Background="#1AFFFFFF" CornerRadius="4"
                                    Padding="5,1">
                                <TextBlock Text="F3" FontSize="10"
                                           Foreground="#80FFFFFF"/>
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Footer: cerrar sesión -->
                <Border Grid.Row="3"
                        BorderBrush="#1AFFFFFF" BorderThickness="0,0.5,0,0"
                        Padding="8,10">
                    <Button Cursor="Hand"
                            BorderThickness="0"
                            Padding="10,9"
                            Click="BtnCerrarSesion_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg"
                                        Background="#33DC3545"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⇥" FontSize="13"
                                                   Foreground="#FFB3B3"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Cerrar sesión · F12"
                                                   FontSize="12" FontWeight="Medium"
                                                   Foreground="#FFB3B3"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background"
                                                Value="#55DC3545"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════
             CONTENIDO PRINCIPAL
        ═══════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Top bar          -->
                <RowDefinition Height="Auto"/>
                <!-- Filtro período   -->
                <RowDefinition Height="Auto"/>
                <!-- Tarjetas métricas-->
                <RowDefinition Height="*"/>
                <!-- Tabla            -->
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Margin="18,14,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Mi registro de caja"
                               FontSize="15" FontWeight="Medium"
                               Foreground="#1A1A1A"/>
                    <TextBlock Text="Resumen de ventas de tu turno"
                               FontSize="12" Foreground="#888888"
                               Margin="0,1,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="BtnExportar"
                        Style="{StaticResource BtnVerde}"
                        FontSize="12" Padding="14,8"
                        Click="BtnExportar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↓" FontSize="13" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Exportar cierre de caja PDF"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Fila filtros de período -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="18,10,18,0"
                        VerticalAlignment="Center">
                <TextBlock Text="Ver registros de:"
                           FontSize="12" Foreground="#666666"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <Button x:Name="BtnPeriodoHoy"
                        Content="Hoy"
                        Style="{StaticResource BtnPeriodoActivo}"
                        Padding="12,6"
                        Margin="0,0,4,0"
                        Click="BtnPeriodo_Click" Tag="hoy"/>

                <Button x:Name="BtnPeriodoAyer"
                        Content="Ayer"
                        Style="{StaticResource BtnPeriodo}"
                        Padding="12,6"
                        Margin="0,0,4,0"
                        Click="BtnPeriodo_Click" Tag="ayer"/>

                <Button x:Name="BtnPeriodoSemana"
                        Content="Esta semana"
                        Style="{StaticResource BtnPeriodo}"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Click="BtnPeriodo_Click" Tag="semana"/>

                <DatePicker x:Name="DpFecha"
                            FontSize="12"
                            BorderBrush="#DDDDDD"
                            Background="White"
                            SelectedDateChanged="DpFecha_SelectedDateChanged"
                            Width="130"/>
            </StackPanel>

            <!-- Tarjetas métricas -->
            <Grid Grid.Row="2" Margin="18,10,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total recaudado -->
                <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="Total recaudado"
                                   FontSize="11" Foreground="#666666"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtTotalRecaudado"
                                   Text="$0"
                                   FontSize="18" FontWeight="Medium"
                                   Foreground="#1B5E20"/>
                        <TextBlock x:Name="TxtSubTotalRecaudado"
                                   Text="0 ventas del período"
                                   FontSize="11" Foreground="#AAAAAA"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Efectivo -->
                <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="Efectivo"
                                   FontSize="11" Foreground="#666666"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtTotalEfectivo"
                                   Text="$0"
                                   FontSize="18" FontWeight="Medium"
                                   Foreground="#1A1A1A"/>
                        <TextBlock x:Name="TxtSubEfectivo"
                                   Text="0 transacciones"
                                   FontSize="11" Foreground="#AAAAAA"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta -->
                <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="Tarjeta de crédito"
                                   FontSize="11" Foreground="#666666"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtTotalTarjeta"
                                   Text="$0"
                                   FontSize="18" FontWeight="Medium"
                                   Foreground="#1A1A1A"/>
                        <TextBlock x:Name="TxtSubTarjeta"
                                   Text="0 transacciones · con recargo"
                                   FontSize="11" Foreground="#AAAAAA"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Transferencia -->
                <Border Grid.Column="6" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="Transferencia"
                                   FontSize="11" Foreground="#666666"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtTotalTransferencia"
                                   Text="$0"
                                   FontSize="18" FontWeight="Medium"
                                   Foreground="#1A1A1A"/>
                        <TextBlock x:Name="TxtSubTransferencia"
                                   Text="0 transacciones"
                                   FontSize="11" Foreground="#AAAAAA"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ─── TABLA DE VENTAS ─── -->
            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#EEEEEE" BorderThickness="0.5"
                    Margin="18,10,18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Encabezado sección -->
                        <RowDefinition Height="*"/>
                        <!-- DataGrid           -->
                        <RowDefinition Height="Auto"/>
                        <!-- Paginación         -->
                    </Grid.RowDefinitions>

                    <!-- Título sección tabla -->
                    <Border Grid.Row="0"
                            BorderBrush="#EEEEEE" BorderThickness="0,0,0,0.5"
                            Padding="14,10">
                        <Grid>
                            <TextBlock Text="Detalle de ventas"
                                       FontSize="13" FontWeight="Medium"
                                       Foreground="#1A1A1A"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtConteoVentas"
                                       Text="0 ventas registradas"
                                       FontSize="12" Foreground="#888888"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                              x:Name="DgVentas"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F0F0F0"
                              BorderThickness="0"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#FAFAFA"
                              FontSize="12"
                              ColumnHeaderHeight="34"
                              RowHeight="34"
                              SelectionMode="Single"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"  Value="#2E7D32"/>
                                <Setter Property="Foreground"  Value="White"/>
                                <Setter Property="FontSize"    Value="11"/>
                                <Setter Property="FontWeight"  Value="Medium"/>
                                <Setter Property="Padding"     Value="10,0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Comprobante -->
                            <DataGridTextColumn Header="#"
                                                Binding="{Binding NumeroComprobante}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#888888"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Hora -->
                            <DataGridTextColumn Header="Hora"
                                                Binding="{Binding HoraDisplay}"
                                                Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#888888"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Material (primer ítem) -->
                            <DataGridTextColumn Header="Material"
                                                Binding="{Binding PrimerMaterial}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Medida -->
                            <DataGridTextColumn Header="Medida"
                                                Binding="{Binding MedidaDisplay}"
                                                Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#888888"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cantidad ítems -->
                            <DataGridTextColumn Header="Cant."
                                                Binding="{Binding CantidadItems}"
                                                Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Total -->
                            <DataGridTemplateColumn Header="Total" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalDisplay}"
                                                   FontWeight="Medium"
                                                   Foreground="#1B5E20"
                                                   VerticalAlignment="Center"
                                                   Padding="10,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Método de pago (badge) -->
                            <DataGridTemplateColumn Header="Método" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="BadgeMetodo"
                                                CornerRadius="20"
                                                Padding="8,2"
                                                HorizontalAlignment="Left"
                                                Margin="10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#EAF3DE"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MetodoPago}" Value="tarjeta">
                                                            <Setter Property="Background" Value="#FAEEDA"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MetodoPago}" Value="transferencia">
                                                            <Setter Property="Background" Value="#E6F1FB"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding MetodoPagoDisplay}"
                                                       FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#27500A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MetodoPago}" Value="tarjeta">
                                                                <Setter Property="Foreground" Value="#633806"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MetodoPago}" Value="transferencia">
                                                                <Setter Property="Foreground" Value="#0C447C"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Botón Ver -->
                            <DataGridTemplateColumn Header="Comp." Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Ver"
                                                Style="{StaticResource BtnVer}"
                                                Padding="10,3"
                                                Tag="{Binding VentaId}"
                                                Click="BtnVerDetalle_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <!-- Estado vacío -->
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Style.Triggers>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGrid">
                                                    <StackPanel HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Margin="0,40,0,0">
                                                        <TextBlock Text="◻" FontSize="28"
                                                                   Foreground="#CCCCCC"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="No hay ventas registradas en este período"
                                                                   FontSize="13" Foreground="#AAAAAA"
                                                                   Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Paginación -->
                    <Border Grid.Row="2"
                            BorderBrush="#EEEEEE" BorderThickness="0,0.5,0,0"
                            Padding="12,9">
                        <Grid>
                            <TextBlock x:Name="TxtPaginaInfo"
                                       FontSize="12" Foreground="#888888"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button x:Name="BtnPagAnt"
                                        Content="Ant."
                                        Style="{StaticResource BtnVer}"
                                        Padding="9,4"
                                        Margin="0,0,4,0"
                                        IsEnabled="False"
                                        Click="BtnPagAnt_Click"/>
                                <Border x:Name="BadgePagina"
                                        Background="#2E7D32"
                                        CornerRadius="4"
                                        Padding="9,4">
                                    <TextBlock x:Name="TxtPaginaActual"
                                               Text="1"
                                               FontSize="12" Foreground="White"/>
                                </Border>
                                <Button x:Name="BtnPagSig"
                                        Content="Sig."
                                        Style="{StaticResource BtnVer}"
                                        Padding="9,4"
                                        Margin="4,0,0,0"
                                        IsEnabled="False"
                                        Click="BtnPagSig_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>