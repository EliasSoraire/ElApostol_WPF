<Window x:Class="ElApostol_WPF.UI.Dueño.CambiarContrasenaEmpleadoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambiar contraseña de empleado"
        Height="520" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Border Background="White" CornerRadius="10"
            BorderBrush="#DDDDDD" BorderThickness="0.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <Border Grid.Row="0" Background="#1B5E20"
                    CornerRadius="10,10,0,0"
                    Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Cambiar contraseña de empleado"
                               FontSize="15" FontWeight="Medium" Foreground="White"/>
                    <TextBlock Text="La contraseña es temporal — el empleado deberá cambiarla al ingresar"
                               FontSize="12" Foreground="#A6FFFFFF" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══ BODY ═══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,18,20,0">

                    <!-- Selector empleado -->
                    <Border Background="#F5F5F5" CornerRadius="8"
                            BorderBrush="#DDDDDD" BorderThickness="0.5"
                            Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="SELECCIONÁ EL EMPLEADO"
                                       FontSize="10" FontWeight="Medium"
                                       Foreground="#666666" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar dinámico -->
                                <Border x:Name="AvatarBorder" Grid.Column="0"
                                        Width="36" Height="36" CornerRadius="18"
                                        Background="#EAF3DE" Margin="0,0,10,0">
                                    <TextBlock x:Name="TxtAvatar" Text="—"
                                               FontSize="13" FontWeight="Medium"
                                               Foreground="#27500A"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <ComboBox x:Name="CmbEmpleado" Grid.Column="1"
                                          Height="34" FontSize="13" Padding="10,0"
                                          Background="White"
                                          BorderBrush="#DDDDDD" BorderThickness="1"
                                          SelectionChanged="CmbEmpleado_SelectionChanged"/>
                            </Grid>

                            <!-- Info empleado -->
                            <StackPanel x:Name="PanelInfoEmpleado"
                                        Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="Collapsed">
                                <Ellipse Width="6" Height="6" Fill="#2E7D32"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtInfoEmpleado"
                                           FontSize="12" Foreground="#666666"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Advertencia -->
                    <Border Background="#FAEEDA" CornerRadius="6"
                            BorderBrush="#EF9F27" BorderThickness="0.5"
                            Padding="12,10" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="13" Foreground="#854F0B"
                                       Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock Text="Comunicate con el empleado para informarle la contraseña temporal antes de guardar."
                                       FontSize="12" Foreground="#633806"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Separador -->
                    <Border BorderBrush="#EEEEEE" BorderThickness="0,0.5,0,0" Margin="0,0,0,14"/>

                    <!-- Generador automático -->
                    <TextBlock Text="O GENERÁ UNA CONTRASEÑA AUTOMÁTICA"
                               FontSize="10" FontWeight="Medium"
                               Foreground="#666666" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Generar contraseña"
                                Height="32" Padding="12,0"
                                FontSize="12" FontWeight="Medium"
                                Cursor="Hand"
                                Foreground="#27500A" Background="#EAF3DE"
                                BorderBrush="#2E7D32" BorderThickness="0.5"
                                Margin="0,0,8,0"
                                Click="BtnGenerar_Click"/>
                        <Border Grid.Column="1" Background="#F5F5F5"
                                CornerRadius="6" BorderBrush="#DDDDDD" BorderThickness="0.5"
                                Padding="10,0" Height="32">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtGenerada" Text="— sin generar —"
                                           FontSize="12" FontFamily="Consolas"
                                           Foreground="#AAAAAA"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="BtnCopiar" Grid.Column="1"
                                        Content="Copiar"
                                        FontSize="11" FontWeight="Medium"
                                        Foreground="#2E7D32" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand"
                                        Visibility="Collapsed"
                                        Click="BtnCopiar_Click"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Campo contraseña -->
                    <TextBlock Text="CONTRASEÑA TEMPORAL"
                               FontSize="10" FontWeight="Medium"
                               Foreground="#666666" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,14">
                        <PasswordBox x:Name="PbPass1"
                                     Height="34" FontSize="13" Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     Background="#F5F5F5"
                                     BorderBrush="#DDDDDD" BorderThickness="1"
                                     PasswordChanged="Pass_Changed"/>
                        <TextBox x:Name="TxtPass1Visible"
                                 Height="34" FontSize="13" Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F5F5F5"
                                 BorderBrush="#DDDDDD" BorderThickness="1"
                                 Visibility="Collapsed"
                                 TextChanged="TxtPassVisible_Changed"/>
                        <Button x:Name="BtnOjoPass1"
                                Content="●" FontSize="11"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Foreground="#AAAAAA"
                                Click="BtnOjoPass1_Click"/>
                    </Grid>

                    <!-- Campo confirmar -->
                    <TextBlock Text="CONFIRMAR CONTRASEÑA"
                               FontSize="10" FontWeight="Medium"
                               Foreground="#666666" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,6">
                        <PasswordBox x:Name="PbPass2"
                                     Height="34" FontSize="13" Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     Background="#F5F5F5"
                                     BorderBrush="#DDDDDD" BorderThickness="1"
                                     PasswordChanged="Pass_Changed"/>
                        <TextBox x:Name="TxtPass2Visible"
                                 Height="34" FontSize="13" Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F5F5F5"
                                 BorderBrush="#DDDDDD" BorderThickness="1"
                                 Visibility="Collapsed"
                                 TextChanged="TxtPassVisible_Changed"/>
                        <Button x:Name="BtnOjoPass2"
                                Content="●" FontSize="11"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Foreground="#AAAAAA"
                                Click="BtnOjoPass2_Click"/>
                    </Grid>

                    <!-- Hint coincidencia -->
                    <TextBlock x:Name="TxtMatchHint"
                               FontSize="11" Margin="0,0,0,16"
                               Visibility="Collapsed"/>

                </StackPanel>
            </ScrollViewer>

            <!-- ═══ FOOTER ═══ -->
            <Border Grid.Row="2" BorderBrush="#EEEEEE" BorderThickness="0,0.5,0,0"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar"
                            Height="36" FontSize="13" Margin="0,0,10,0"
                            Cursor="Hand" Background="Transparent"
                            BorderBrush="#DDDDDD" BorderThickness="0.5"
                            Foreground="#666666"
                            Click="BtnCancelar_Click"/>
                    <Button x:Name="BtnGuardar" Grid.Column="1"
                            Content="Guardar contraseña"
                            Height="36" FontSize="13" FontWeight="Medium"
                            Cursor="Hand" Background="#2E7D32"
                            BorderThickness="0" Foreground="White"
                            IsEnabled="False"
                            Click="BtnGuardar_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>