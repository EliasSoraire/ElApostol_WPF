<Window x:Class="ElApostol_WPF.UI.Dueño.AgregarEditarProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar material"
        Width="860" Height="620"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- Colores base -->
        <Color x:Key="VerdePrimario">#2E7D32</Color>
        <Color x:Key="VerdeOscuro">#1B5E20</Color>
        <Color x:Key="VerdeSuave">#EAF3DE</Color>
        <Color x:Key="VerdeTexto">#27500A</Color>
        <Color x:Key="RojoError">#A32D2D</Color>
        <Color x:Key="RojoSuave">#FCEBEB</Color>
        <Color x:Key="RojoTexto">#791F1F</Color>

        <SolidColorBrush x:Key="BrushVerdePrimario"  Color="#2E7D32"/>
        <SolidColorBrush x:Key="BrushVerdeOscuro"    Color="#1B5E20"/>
        <SolidColorBrush x:Key="BrushVerdeSuave"     Color="#EAF3DE"/>
        <SolidColorBrush x:Key="BrushVerdeTexto"     Color="#27500A"/>
        <SolidColorBrush x:Key="BrushRojoError"      Color="#A32D2D"/>
        <SolidColorBrush x:Key="BrushBorde"          Color="#E0E0E0"/>
        <SolidColorBrush x:Key="BrushBordeSuave"     Color="#EEEEEE"/>
        <SolidColorBrush x:Key="BrushFondoSecundario" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="BrushTextoSecundario" Color="#757575"/>
        <SolidColorBrush x:Key="BrushTextoTerciario" Color="#9E9E9E"/>

        <!-- Estilo de TextBox — borde negro, fondo gris claro -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Padding"            Value="9,7"/>
            <Setter Property="FontSize"           Value="14"/>
            <Setter Property="Foreground"         Value="#212121"/>
            <Setter Property="Background"         Value="#F7F7F7"/>
            <Setter Property="BorderBrush"        Value="#222222"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2E7D32"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#2E7D32" BlurRadius="6" ShadowDepth="0" Opacity="0.20"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de ComboBox — borde negro, fondo gris claro -->
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Padding"         Value="9,7"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Foreground"      Value="#212121"/>
            <Setter Property="Background"      Value="#F7F7F7"/>
            <Setter Property="BorderBrush"     Value="#222222"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="36"/>
        </Style>

        <!-- Label de campo -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="FontWeight"    Value="Medium"/>
            <Setter Property="Foreground"    Value="#757575"/>
            <Setter Property="Margin"        Value="0,0,0,4"/>
        </Style>

        <!-- Título de sección -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#757575"/>
            <Setter Property="Margin"     Value="0,16,0,10"/>
        </Style>

        <!-- Botón primario verde -->
        <Style x:Key="BtnPrimario" TargetType="Button">
            <Setter Property="Background"  Value="#2E7D32"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="14"/>
            <Setter Property="FontWeight"  Value="Medium"/>
            <Setter Property="Padding"     Value="24,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#145214"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#A5D6A7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón cancelar -->
        <Style x:Key="BtnCancelar" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#757575"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Padding"         Value="20,9"/>
            <Setter Property="BorderBrush"     Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón agregar/actualizar variante -->
        <Style x:Key="BtnAgregarVar" TargetType="Button">
            <Setter Property="Background"      Value="#2E7D32"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="19"/>
            <Setter Property="Width"           Value="36"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1B5E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón cancelar edición variante -->
        <Style x:Key="BtnCancelarVar" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#757575"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="BorderBrush"     Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FCEBEB"/>
                                <Setter Property="Foreground" Value="#791F1F"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#F5C6C6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón eliminar variante (✕) -->
        <Style x:Key="BtnEliminarVar" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#9E9E9E"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="4,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FCEBEB"/>
                                <Setter Property="Foreground" Value="#791F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ HEADER ══════════════ -->
        <Border Grid.Row="0" Background="#1B5E20">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTituloVentana"
                               Text="Agregar material"
                               FontSize="16" FontWeight="Medium"
                               Foreground="White" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Border x:Name="BadgeModo"
                            Background="#26FFFFFF" CornerRadius="12"
                            Padding="10,3" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBadge"
                                   Text="Nuevo registro"
                                   FontSize="12" Foreground="#D9FFFFFF"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════ BODY ══════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="255"/>
            </Grid.ColumnDefinitions>

            <!-- ── FORMULARIO (izquierda) ── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          Padding="24,16,20,16">
                <StackPanel>

                    <TextBlock Style="{StaticResource SectionTitle}"
                               Text="INFORMACIÓN GENERAL"
                               Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="CÓDIGO"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Prefijo fijo: sale de la categoría -->
                                <Border Grid.Column="0" Height="36" MinWidth="58"
                                        Background="#EAF3DE" BorderBrush="#222222"
                                        BorderThickness="1,1,0,1" CornerRadius="5,0,0,5"
                                        Padding="10,0"
                                        ToolTip="El prefijo se elige con la categoría">
                                    <TextBlock x:Name="TxtPrefijo" Text="···-"
                                               FontSize="14" FontWeight="Bold" FontFamily="Consolas"
                                               Foreground="#27500A"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBox x:Name="TxtCodigoNumero" Grid.Column="1"
                                         Style="{StaticResource InputStyle}"
                                         Height="36" MaxLength="6"
                                         FontFamily="Consolas"
                                         PreviewTextInput="TxtCodigoNumero_PreviewTextInput"
                                         DataObject.Pasting="TxtCodigoNumero_Pasting"
                                         TextChanged="TxtCodigoNumero_TextChanged"/>
                            </Grid>
                            <TextBlock x:Name="TxtCodigoHint"
                                       FontSize="12" Foreground="#27500A"
                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Elegí una categoría para ver el último código usado."/>
                            <TextBlock x:Name="TxtErrorCodigo"
                                       FontSize="12" Foreground="#A32D2D"
                                       Margin="0,3,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="NOMBRE DEL MATERIAL"/>
                            <TextBox x:Name="TxtNombre"
                                     Style="{StaticResource InputStyle}"
                                     Height="36"
                                     TextChanged="Campo_Changed"/>
                            <TextBlock x:Name="TxtErrorNombre"
                                       FontSize="12" Foreground="#A32D2D"
                                       Margin="0,3,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="MARCA"/>
                            <TextBox x:Name="TxtMarca"
                                     Style="{StaticResource InputStyle}"
                                     Height="36"
                                     TextChanged="Campo_Changed"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="CATEGORÍA"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbCategoria"
                                          Style="{StaticResource ComboStyle}"
                                          SelectionChanged="CmbCategoria_SelectionChanged"
                                          DisplayMemberPath="Nombre"
                                          SelectedValuePath="Id"/>
                                <Button Grid.Column="1" Style="{StaticResource BtnCancelar}"
                                        Content="⚙" FontSize="15" Padding="10,0" Height="36"
                                        Margin="6,0,0,0"
                                        ToolTip="Agregar, editar o eliminar categorías"
                                        Click="BtnGestionarCategorias_Click"/>
                            </Grid>
                            <TextBlock x:Name="TxtErrorCategoria"
                                       FontSize="12" Foreground="#A32D2D"
                                       Margin="0,3,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="PROVEEDOR"/>
                        <TextBox x:Name="TxtProveedor"
                                 Style="{StaticResource InputStyle}"
                                 Height="36"
                                 TextChanged="Campo_Changed"/>
                    </StackPanel>

                    <!-- Separador sección variantes -->
                    <Border Margin="0,20,0,10" Height="1" Background="#EEEEEE"/>
                    <TextBlock Style="{StaticResource SectionTitle}"
                               Text="VARIANTES DE STOCK"
                               Margin="0,0,0,10"/>

                    <!-- Hint de edición -->
                    <Border x:Name="PanelHintEdicion"
                            Background="#FFF8E1" BorderBrush="#FFE082"
                            BorderThickness="1" CornerRadius="5"
                            Padding="10,6" Margin="0,0,0,8"
                            Visibility="Collapsed">
                        <TextBlock Text="✏  Editando variante — modificá los campos y hacé clic en ✓ para confirmar"
                                   FontSize="12" Foreground="#795548"/>
                    </Border>

                    <!-- Fila de entrada de variante -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition x:Name="ColCancelarVar" Width="0"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="MEDIDA / VARIANTE"/>
                            <TextBox x:Name="TxtVarMedida"
                                     Style="{StaticResource InputStyle}"
                                     Height="36"
                                     TextChanged="CampoVariante_TextChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="CALIDAD"/>
                            <TextBox x:Name="TxtVarCalidad"
                                     Style="{StaticResource InputStyle}"
                                     Height="36"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="PRECIO ($)"/>
                            <TextBox x:Name="TxtVarPrecio"
                                     Style="{StaticResource InputStyle}"
                                     Height="36"
                                     PreviewTextInput="Precio_PreviewTextInput"
                                     TextChanged="CampoVariante_TextChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="STOCK INI."/>
                            <TextBox x:Name="TxtVarStock"
                                     Style="{StaticResource InputStyle}"
                                     Height="36"
                                     PreviewTextInput="SoloDigitos_PreviewTextInput"
                                     TextChanged="CampoVariante_TextChanged"/>
                        </StackPanel>

                        <Button x:Name="BtnConfirmarVariante"
                                Grid.Column="8"
                                Style="{StaticResource BtnAgregarVar}"
                                Click="BtnConfirmarVariante_Click"
                                ToolTip="Agregar variante"
                                Content="+"/>

                        <Button x:Name="BtnCancelarEdicionVar"
                                Grid.Column="9"
                                Style="{StaticResource BtnCancelarVar}"
                                Click="BtnCancelarEdicionVar_Click"
                                Content="✕"
                                ToolTip="Cancelar edición"
                                Visibility="Collapsed"
                                Margin="4,0,0,0"/>
                    </Grid>

                    <!-- Error de la fila de variante -->
                    <Border x:Name="TxtErrorVarianteBorde" Margin="0,8,0,0">
                        <TextBlock x:Name="TxtErrorVarianteInput"
                                   FontSize="12" FontWeight="Medium" Foreground="#A32D2D"
                                   Background="#FCEBEB" Padding="10,6"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                    </Border>

                    <!-- Tabla de variantes -->
                    <Border Margin="0,12,0,0"
                            BorderBrush="#EEEEEE" BorderThickness="1"
                            CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#EAF3DE" CornerRadius="5,5,0,0">
                                <Grid Margin="10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Medida"  FontSize="12" FontWeight="Medium" Foreground="#27500A"/>
                                    <TextBlock Grid.Column="1" Text="Calidad" FontSize="12" FontWeight="Medium" Foreground="#27500A"/>
                                    <TextBlock Grid.Column="2" Text="Precio"  FontSize="12" FontWeight="Medium" Foreground="#27500A"/>
                                    <TextBlock Grid.Column="3" Text="Stock"   FontSize="12" FontWeight="Medium" Foreground="#27500A"/>
                                    <TextBlock Grid.Column="4" Text=""        FontSize="12" FontWeight="Medium" Foreground="#27500A"/>
                                </Grid>
                            </Border>

                            <ListView x:Name="ListVariantes"
                                      Grid.Row="1"
                                      BorderThickness="0"
                                      Background="White"
                                      SelectionMode="Single"
                                      MinHeight="60"
                                      MaxHeight="180"
                                      MouseDoubleClick="ListVariantes_MouseDoubleClick"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="BorderBrush" Value="#EEEEEE"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F9FBF7"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#FFF8E1"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="36"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Medida}"  FontSize="13" Foreground="#212121" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Calidad}" FontSize="13" Foreground="#212121" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" FontSize="13" Foreground="#212121" VerticalAlignment="Center">
                                                <Run Text="$"/>
                                                <Run Text="{Binding PrecioUnitario, StringFormat=N2}"/>
                                            </TextBlock>
                                            <TextBlock Grid.Column="3" Text="{Binding StockActual}" FontSize="13" Foreground="#212121" VerticalAlignment="Center"/>
                                            <Button Grid.Column="4"
                                                    Style="{StaticResource BtnEliminarVar}"
                                                    Tag="{Binding}"
                                                    Click="BtnEliminarVariante_Click"
                                                    Content="✕"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock x:Name="TxtVacioVariantes"
                                       Grid.Row="1"
                                       Text="Agregá al menos una variante para este material"
                                       FontSize="13" Foreground="#9E9E9E"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,16"
                                       Visibility="Visible"/>
                        </Grid>
                    </Border>

                    <!-- Hint doble click -->
                    <TextBlock x:Name="TxtHintDobleClick"
                               Text="💡 Doble clic en una variante para editarla"
                               FontSize="12" Foreground="#9E9E9E"
                               Margin="0,5,0,0"
                               Visibility="Collapsed"/>

                    <TextBlock x:Name="TxtErrorVariantes"
                               FontSize="12" Foreground="#A32D2D"
                               Margin="0,6,0,0" Visibility="Collapsed"
                               Text="Agregá al menos una variante antes de guardar."/>

                </StackPanel>
            </ScrollViewer>

            <!-- Separador vertical -->
            <Border Grid.Column="1" Background="#EEEEEE"/>

            <!-- ── PREVIEW (derecha) ── -->
            <Border Grid.Column="2" Background="#F5F5F5" Padding="16">
                <StackPanel>
                    <TextBlock Text="VISTA PREVIA"
                               FontSize="12" FontWeight="Medium"
                               Foreground="#757575" Margin="0,0,0,12"/>

                    <Border Background="White"
                            BorderBrush="#EEEEEE" BorderThickness="1"
                            CornerRadius="6" Padding="14">
                        <StackPanel>

                            <!-- Código -->
                            <TextBlock x:Name="PrevCodigo"
                                       Text="— sin código —"
                                       FontSize="12" Foreground="#9E9E9E"
                                       FontFamily="Consolas"/>

                            <!-- Nombre -->
                            <TextBlock x:Name="PrevNombre"
                                       Text="Nombre del material"
                                       FontSize="16" FontWeight="Medium"
                                       Foreground="#BDBDBD"
                                       Margin="0,4,0,2"
                                       TextWrapping="Wrap"/>

                            <!-- Marca -->
                            <TextBlock x:Name="PrevMarca"
                                       Text="Marca no especificada"
                                       FontSize="13" Foreground="#9E9E9E"
                                       Margin="0,0,0,10"/>

                            <Border Height="1" Background="#EEEEEE" Margin="0,0,0,10"/>

                            <!-- Categoría -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Categoría" FontSize="13" Foreground="#757575" VerticalAlignment="Center"/>
                                <Border x:Name="PrevCategoriaBadge"
                                        Grid.Column="1"
                                        Background="#EAF3DE" CornerRadius="12"
                                        Padding="8,3" Visibility="Collapsed">
                                    <TextBlock x:Name="PrevCategoriaTexto"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="#27500A"/>
                                </Border>
                                <TextBlock x:Name="PrevCategoriaVacia"
                                           Grid.Column="1"
                                           Text="—" FontSize="13"
                                           Foreground="#9E9E9E"/>
                            </Grid>

                            <!-- Proveedor -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Proveedor" FontSize="13" Foreground="#757575"/>
                                <TextBlock x:Name="PrevProveedor"
                                           Grid.Column="1"
                                           Text="—" FontSize="13"
                                           Foreground="#9E9E9E"
                                           FontWeight="Medium"/>
                            </Grid>

                            <Border Height="1" Background="#EEEEEE" Margin="0,0,0,10"/>

                            <!-- Resumen de precios -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Variantes" FontSize="13" Foreground="#757575" VerticalAlignment="Center"/>
                                <Border x:Name="PrevContadorBadge"
                                        Grid.Column="1"
                                        Background="#EAF3DE" CornerRadius="10"
                                        Padding="8,2" Visibility="Collapsed">
                                    <TextBlock x:Name="PrevContadorTexto"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="#27500A"/>
                                </Border>
                                <TextBlock x:Name="PrevContadorVacio"
                                           Grid.Column="1"
                                           Text="—" FontSize="13" Foreground="#9E9E9E"/>
                            </Grid>

                            <!-- Rango de precios -->
                            <TextBlock x:Name="PrevRangoPrecios"
                                       Text=""
                                       FontSize="14" FontWeight="Medium"
                                       Foreground="#1B5E20"
                                       Margin="0,2,0,10"
                                       Visibility="Collapsed"/>

                            <Border Height="1" Background="#EEEEEE" Margin="0,0,0,10"/>

                            <!-- Variantes preview -->
                            <TextBlock Text="VARIANTES"
                                       FontSize="12" FontWeight="Medium"
                                       Foreground="#757575" Margin="0,0,0,6"/>

                            <ItemsControl x:Name="PrevVariantes">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F5F5F5" CornerRadius="5"
                                                Margin="0,0,0,4" Padding="8,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="13" Foreground="#424242" TextWrapping="Wrap">
                                                    <Run Text="{Binding Medida}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Calidad}"/>
                                                </TextBlock>
                                                <Border Grid.Column="1"
                                                        Background="#EAF3DE" CornerRadius="10"
                                                        Padding="6,2">
                                                    <TextBlock FontSize="12" FontWeight="Medium"
                                                               Foreground="#27500A">
                                                        <Run Text="$"/>
                                                        <Run Text="{Binding PrecioUnitario, StringFormat=N2}"/>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="PrevVariantesVacia"
                                       Text="Sin variantes aún"
                                       FontSize="13" Foreground="#9E9E9E"
                                       FontStyle="Italic"
                                       Visibility="Visible"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════ FOOTER ══════════════ -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtFooterHint"
                           Text="Completá los campos obligatorios para guardar"
                           FontSize="13" Foreground="#9E9E9E"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,0,0">
                    <Button Style="{StaticResource BtnCancelar}"
                            Content="Cancelar"
                            Click="BtnCancelar_Click"
                            Margin="0,0,8,0"/>
                    <Button x:Name="BtnGuardar"
                            Style="{StaticResource BtnPrimario}"
                            Content="Guardar material"
                            Click="BtnGuardar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>