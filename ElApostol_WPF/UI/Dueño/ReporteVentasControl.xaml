<UserControl x:Class="ElApostol_WPF.UI.Dueño.ReporteVentasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">

    <UserControl.Resources>
        <!-- Botón período (pills) -->
        <Style x:Key="PeriodBtn" TargetType="Button">
            <Setter Property="Padding"         Value="14,5"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderBrush"     Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#666666"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón período activo -->
        <Style x:Key="PeriodBtnActive" TargetType="Button" BasedOn="{StaticResource PeriodBtn}">
            <Setter Property="Background"   Value="#EAF3DE"/>
            <Setter Property="BorderBrush"  Value="#2E7D32"/>
            <Setter Property="Foreground"   Value="#27500A"/>
            <Setter Property="FontWeight"   Value="Medium"/>
        </Style>

        <!-- Botón paginación -->
        <Style x:Key="PagBtn" TargetType="Button">
            <Setter Property="Padding"         Value="10,4"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderBrush"     Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#666666"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón verde general -->
        <Style x:Key="BtnVerde" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#2E7D32"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1B5E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top bar título -->
            <RowDefinition Height="Auto"/>
            <!-- Fila de filtros/período -->
            <RowDefinition Height="Auto"/>
            <!-- Cards métricas -->
            <RowDefinition Height="Auto"/>
            <!-- Gráfico de barras -->
            <RowDefinition Height="*"/>
            <!-- Tabla + paginación -->
        </Grid.RowDefinitions>

        <!-- ── Top bar ── -->
        <Grid Grid.Row="0" Margin="20,16,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Reporte de ventas"
                           FontSize="16" FontWeight="Medium" Foreground="#1A1A1A"/>
                <TextBlock x:Name="TxtSubtitulo"
                           Text="Cargando datos..."
                           FontSize="12" Foreground="#666666" Margin="0,1,0,0"/>
            </StackPanel>
            <!-- Botón exportar -->
            <Button Grid.Column="1"
    Content="⬇  Exportar PDF"
    Style="{StaticResource BtnVerde}"
    FontSize="12" Padding="14,7"
    Click="BtnExportar_Click"
    VerticalAlignment="Top"/>

        </Grid>

        <!-- ── Fila período + filtros ── -->
        <Grid Grid.Row="1" Margin="20,10,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Pills período -->
            <Button x:Name="BtnPeriodoHoy"
                    Grid.Column="0"
                    Content="Hoy"
                    Style="{StaticResource PeriodBtn}"
                    Margin="0,0,4,0"
                    Click="BtnPeriodo_Click" Tag="hoy"/>
            <Button x:Name="BtnPeriodoSemana"
                    Grid.Column="1"
                    Content="Esta semana"
                    Style="{StaticResource PeriodBtnActive}"
                    Margin="0,0,4,0"
                    Click="BtnPeriodo_Click" Tag="semana"/>
            <Button x:Name="BtnPeriodoMes"
                    Grid.Column="2"
                    Content="Este mes"
                    Style="{StaticResource PeriodBtn}"
                    Margin="0,0,4,0"
                    Click="BtnPeriodo_Click" Tag="mes"/>
            <Button x:Name="BtnPeriodoPersonalizado"
                    Grid.Column="3"
                    Content="Personalizado"
                    Style="{StaticResource PeriodBtn}"
                    Margin="0,0,4,0"
                    Click="BtnPeriodo_Click" Tag="custom"/>

            <!-- Separador visual -->
            <Border Grid.Column="4"
                    Width="1" Background="#DDDDDD"
                    Margin="4,3"/>

            <!-- Desde -->
            <DatePicker x:Name="DpDesde"
                        Grid.Column="5"
                        FontSize="12"
                        Width="100"
                        Margin="4,0,0,0"
                        SelectedDateChanged="Filtros_Changed"
                        IsEnabled="False"/>

            <!-- Hasta -->
            <TextBlock Grid.Column="7"
                       Text="hasta"
                       FontSize="12" Foreground="#666666"
                       VerticalAlignment="Center"/>
            <DatePicker x:Name="DpHasta"
                        Grid.Column="9"
                        FontSize="12"
                        Width="100"
                        Margin="0"
                        SelectedDateChanged="Filtros_Changed"
                        IsEnabled="False"/>

            <!-- Filtro empleado -->
            <ComboBox x:Name="CmbEmpleado"
                      Grid.Column="11"
                      VerticalContentAlignment="Center"
                      Width="140"
                      FontSize="12"
                      Padding="8,0"
                      Height="30"
                      SelectionChanged="Filtros_Changed"/>
        </Grid>

        <!-- ── Cards métricas ── -->
        <UniformGrid Grid.Row="2" Rows="1" Columns="4"
                     Margin="20,12,20,0">

            <!-- Total ingresos -->
            <Border Background="White" CornerRadius="8"
                    BorderBrush="#EEEEEE" BorderThickness="0.5"
                    Padding="14,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total ingresos" FontSize="11" Foreground="#666666"/>
                    <TextBlock x:Name="TxtIngresos"
                               Text="$0"
                               FontSize="20" FontWeight="Medium" Foreground="#1B5E20"
                               Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtPeriodoCard"
                               Text="Esta semana"
                               FontSize="11" Foreground="#AAAAAA"/>
                </StackPanel>
            </Border>

            <!-- Transacciones -->
            <Border Background="White" CornerRadius="8"
                    BorderBrush="#EEEEEE" BorderThickness="0.5"
                    Padding="14,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Transacciones" FontSize="11" Foreground="#666666"/>
                    <TextBlock x:Name="TxtTransacciones"
                               Text="0"
                               FontSize="20" FontWeight="Medium" Foreground="#1A1A1A"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="operaciones registradas" FontSize="11" Foreground="#AAAAAA"/>
                </StackPanel>
            </Border>

            <!-- Ticket promedio -->
            <Border Background="White" CornerRadius="8"
                    BorderBrush="#EEEEEE" BorderThickness="0.5"
                    Padding="14,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Ticket promedio" FontSize="11" Foreground="#666666"/>
                    <TextBlock x:Name="TxtTicket"
                               Text="$0"
                               FontSize="20" FontWeight="Medium" Foreground="#1A1A1A"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="por transacción" FontSize="11" Foreground="#AAAAAA"/>
                </StackPanel>
            </Border>

            <!-- Mejor día -->
            <Border Background="White" CornerRadius="8"
                    BorderBrush="#EEEEEE" BorderThickness="0.5"
                    Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Mejor día" FontSize="11" Foreground="#666666"/>
                    <TextBlock x:Name="TxtMejorDia"
                               Text="—"
                               FontSize="20" FontWeight="Medium" Foreground="#1A1A1A"
                               Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtMejorDiaSub"
                               Text="sin datos"
                               FontSize="11" Foreground="#AAAAAA"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ── Gráfico de barras ── -->
        <Border Grid.Row="3"
                Background="White" CornerRadius="8"
                BorderBrush="#EEEEEE" BorderThickness="0.5"
                Margin="20,12,20,0" Padding="16,14">
            <StackPanel>
                <TextBlock x:Name="TxtGraficoTitulo"
                           Text="Ingresos por día"
                           FontSize="12" FontWeight="Medium"
                           Foreground="#666666" Margin="0,0,0,10"/>
                <!-- Barras -->
                <Grid x:Name="GraficoGrid" Height="80">
                    <!-- Las columnas se generan en code-behind -->
                </Grid>
                <!-- Etiquetas de días -->
                <Grid x:Name="GraficoLabels" Height="16" Margin="0,4,0,0">
                    <!-- Las etiquetas se generan en code-behind -->
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Tabla detalle por día ── -->
        <Grid Grid.Row="4" Margin="20,12,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabecera tabla -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtTablaTitulo"
                           Grid.Column="0"
                           Text="Detalle por día"
                           FontSize="13" FontWeight="Medium"
                           Foreground="#1A1A1A"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTablaCount"
                           Grid.Column="1"
                           Text="0 registros"
                           FontSize="12" Foreground="#666666"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Tabla + paginación -->
            <Border Grid.Row="1" Background="White" CornerRadius="8"
                    BorderBrush="#EEEEEE" BorderThickness="0.5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="DgReporte"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F0F0F0"
                              BorderThickness="0"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#FAFAFA"
                              FontSize="12"
                              FontWeight="Bold"
                              Foreground="#000000"
                              ColumnHeaderHeight="36"
                              RowHeight="36"
                              HorizontalContentAlignment="Stretch"
                              SelectionMode="Single"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"  Value="#2E7D32"/>
                                <Setter Property="Foreground"  Value="White"/>
                                <Setter Property="FontSize"    Value="11"/>
                                <Setter Property="FontWeight"  Value="Bold"/>
                                <Setter Property="Padding"     Value="12,0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <!-- Día con badge "mejor" -->
                            <DataGridTemplateColumn Header="Día" Width="Auto" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="12,0">
                                            <TextBlock Text="{Binding DiaNombre}"
                                                       FontWeight="Bold"
                                                       Foreground="#000000"
                                                       VerticalAlignment="Center"/>
                                            <Border x:Name="BadgeMejor"
                                                    Visibility="{Binding BadgeMejorVisibility}"
                                                    Background="#EAF3DE" CornerRadius="10"
                                                    Padding="6,1" Margin="6,0,0,0">
                                                <TextBlock Text="mejor"
                                                           FontSize="10" Foreground="#27500A"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Fecha"
                                                Binding="{Binding FechaDisplay}"
                                                Width="Auto" MinWidth="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#000000"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="0,0,0,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Empleado con badge gris -->
                            <DataGridTemplateColumn Header="Empleado" Width="*" MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F5F5F5" CornerRadius="10"
                                                Padding="8,2" Margin="12,6"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Empleado}"
                                                       FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Ventas"
                                                Binding="{Binding CantidadVentas}"
                                                Width="Auto" MinWidth="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#000000"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Monto total"
                                                Binding="{Binding TotalDisplay}"
                                                Width="Auto" MinWidth="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"       Value="#1B5E20"/>
                                        <Setter Property="FontWeight"       Value="Bold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Ticket prom."
                                                Binding="{Binding TicketDisplay}"
                                                Width="Auto" MinWidth="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"       Value="#000000"/>
                                        <Setter Property="FontWeight"       Value="Bold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Botón "Ver" -->
                            <DataGridTemplateColumn Header="Detalle" Width="Auto" MinWidth="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Ver"
                                                FontSize="11"
                                                Padding="10,3"
                                                Cursor="Hand"
                                                Margin="6,0"
                                                BorderBrush="#DDDDDD"
                                                BorderThickness="0.5"
                                                Background="Transparent"
                                                Foreground="#666666"
                                                Tag="{Binding Fecha}"
                                                Click="BtnVerDia_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bg"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="6"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bg" Property="Background" Value="#EAF3DE"/>
                                                                        <Setter TargetName="bg" Property="BorderBrush" Value="#2E7D32"/>
                                                                        <Setter Property="Foreground" Value="#27500A"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Paginación -->
                    <Border Grid.Row="1"
                            BorderBrush="#EEEEEE" BorderThickness="0,0.5,0,0"
                            Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtPaginaInfo"
                                       Grid.Column="0"
                                       FontSize="12" Foreground="#666666"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        x:Name="PanelPaginacion"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
