<Window x:Class="ElApostol_WPF.UI.Dueño.ReporteVentasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="El Apóstol — Reporte de Ventas"
        Height="680" Width="980"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#F5F5F5"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBg"    Color="#1B5E20"/>
        <SolidColorBrush x:Key="Verde"         Color="#2E7D32"/>
        <SolidColorBrush x:Key="VerdeLight"    Color="#EAF3DE"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#666666"/>
        <SolidColorBrush x:Key="TextTertiary"  Color="#AAAAAA"/>
        <SolidColorBrush x:Key="BorderColor"   Color="#DDDDDD"/>
        <SolidColorBrush x:Key="BgPrimary"     Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgSecondary"   Color="#F5F5F5"/>

        <!-- Botón sidebar normal -->
        <Style x:Key="SbBtn" TargetType="Button">
            <Setter Property="Background"                Value="Transparent"/>
            <Setter Property="Foreground"                Value="#D9FFFFFF"/>
            <Setter Property="BorderThickness"           Value="0"/>
            <Setter Property="FontSize"                  Value="12"/>
            <Setter Property="FontWeight"                Value="Medium"/>
            <Setter Property="Cursor"                    Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding"                   Value="10,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón sidebar activo -->
        <Style x:Key="SbBtnActive" TargetType="Button" BasedOn="{StaticResource SbBtn}">
            <Setter Property="Background" Value="#2DFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Botón período (pills) -->
        <Style x:Key="PeriodBtn" TargetType="Button">
            <Setter Property="Padding"         Value="14,5"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderBrush"     Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#666666"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón período activo -->
        <Style x:Key="PeriodBtnActive" TargetType="Button" BasedOn="{StaticResource PeriodBtn}">
            <Setter Property="Background"   Value="#EAF3DE"/>
            <Setter Property="BorderBrush"  Value="#2E7D32"/>
            <Setter Property="Foreground"   Value="#27500A"/>
            <Setter Property="FontWeight"   Value="Medium"/>
        </Style>

        <!-- Botón paginación -->
        <Style x:Key="PagBtn" TargetType="Button">
            <Setter Property="Padding"         Value="10,4"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderBrush"     Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#666666"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón verde general -->
        <Style x:Key="BtnVerde" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#2E7D32"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1B5E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════ SIDEBAR ══════════════════ -->
        <Border Grid.Column="0" Background="#1B5E20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header usuario -->
                <Border Grid.Row="0" Padding="16,20,16,16"
                        BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,0.5">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="20"
                                Background="#26FFFFFF"
                                HorizontalAlignment="Left" Margin="0,0,0,8">
                            <TextBlock x:Name="TxtAvatar" Text="JR"
                                       FontSize="14" FontWeight="Medium"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtNombreUsuario"
                                   Text="—"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="White"/>
                        <TextBlock Text="Administrador · Dueño"
                                   FontSize="11" Foreground="#99FFFFFF"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Nav -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="8,12,8,0">

                        <TextBlock Text="GESTIÓN" FontSize="10"
                                   Foreground="#66FFFFFF" Margin="8,0,0,4"/>

                        <Button Style="{StaticResource SbBtn}" Click="BtnInventario_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Path Width="16" Height="16" Margin="0,0,8,0"
                                          Fill="#CCFFFFff"
                                          Data="M1,1 H7 V7 H1 Z M9,1 H15 V7 H9 Z M1,9 H7 V15 H1 Z M9,9 H15 V15 H9 Z"/>
                                    <TextBlock Text="Inventario" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1FFFFFFF"
                                        CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="F1" FontSize="10" Foreground="#80FFFFFF"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource SbBtn}" Click="BtnAgregarMaterial_Click" Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="15" Foreground="#CCFFFFff"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Agregar material" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1FFFFFFF"
                                        CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="F2" FontSize="10" Foreground="#80FFFFFF"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource SbBtn}" Click="BtnNuevaVenta_Click" Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="≡" FontSize="15" Foreground="#CCFFFFff"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Nueva venta" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1FFFFFFF"
                                        CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="F3" FontSize="10" Foreground="#80FFFFFF"/>
                                </Border>
                            </Grid>
                        </Button>

                        <TextBlock Text="REPORTES" FontSize="10"
                                   Foreground="#66FFFFFF" Margin="8,12,0,4"/>

                        <!-- ACTIVO -->
                        <Button Style="{StaticResource SbBtnActive}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="📋" FontSize="12"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Reporte de ventas" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1FFFFFFF"
                                        CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="F4" FontSize="10" Foreground="#80FFFFFF"/>
                                </Border>
                            </Grid>
                        </Button>

                        <TextBlock Text="CONFIGURACIÓN" FontSize="10"
                                   Foreground="#66FFFFFF" Margin="8,12,0,4"/>

                        <Button Style="{StaticResource SbBtn}" Click="BtnGestionEmpleados_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="👤" FontSize="12"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Gestionar empleados" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1FFFFFFF"
                                        CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="F5" FontSize="10" Foreground="#80FFFFFF"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource SbBtn}" Click="BtnCambiarClaveEmpleado_Click" Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="🔒" FontSize="12"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Cambiar clave empleado"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="110"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1FFFFFFF"
                                        CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="F6" FontSize="10" Foreground="#80FFFFFF"/>
                                </Border>
                            </Grid>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer cerrar sesión -->
                <Border Grid.Row="2" Padding="8,12"
                        BorderBrush="#1FFFFFFF" BorderThickness="0,0.5,0,0">
                    <Button Click="BtnCerrarSesion_Click" Cursor="Hand" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="#33DC3545"
                                        CornerRadius="6" Padding="10,9">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⇥" FontSize="14"
                                                   Foreground="#FFB3B3"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Cerrar sesión · F12"
                                                   FontSize="12" FontWeight="Medium"
                                                   Foreground="#FFB3B3"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#55DC3545"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════ CONTENIDO PRINCIPAL ══════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Top bar título -->
                <RowDefinition Height="Auto"/>
                <!-- Fila de filtros/período -->
                <RowDefinition Height="Auto"/>
                <!-- Cards métricas -->
                <RowDefinition Height="Auto"/>
                <!-- Gráfico de barras -->
                <RowDefinition Height="*"/>
                <!-- Tabla + paginación -->
            </Grid.RowDefinitions>

            <!-- ── Top bar ── -->
            <Grid Grid.Row="0" Margin="20,16,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Reporte de ventas"
                               FontSize="16" FontWeight="Medium" Foreground="#1A1A1A"/>
                    <TextBlock x:Name="TxtSubtitulo"
                               Text="Cargando datos..."
                               FontSize="12" Foreground="#666666" Margin="0,1,0,0"/>
                </StackPanel>
                <!-- Botón exportar (placeholder visual, podés conectar luego) -->
                <Button Grid.Column="1"
        Content="⬇  Exportar PDF"
        Style="{StaticResource BtnVerde}"
        FontSize="12" Padding="14,7"
        Click="BtnExportar_Click"
        VerticalAlignment="Top"/>

            </Grid>

            <!-- ── Fila período + filtros ── -->
            <Grid Grid.Row="1" Margin="20,10,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Pills período -->
                <Button x:Name="BtnPeriodoHoy"
                        Grid.Column="0"
                        Content="Hoy"
                        Style="{StaticResource PeriodBtn}"
                        Margin="0,0,4,0"
                        Click="BtnPeriodo_Click" Tag="hoy"/>
                <Button x:Name="BtnPeriodoSemana"
                        Grid.Column="1"
                        Content="Esta semana"
                        Style="{StaticResource PeriodBtnActive}"
                        Margin="0,0,4,0"
                        Click="BtnPeriodo_Click" Tag="semana"/>
                <Button x:Name="BtnPeriodoMes"
                        Grid.Column="2"
                        Content="Este mes"
                        Style="{StaticResource PeriodBtn}"
                        Margin="0,0,4,0"
                        Click="BtnPeriodo_Click" Tag="mes"/>
                <Button x:Name="BtnPeriodoPersonalizado"
                        Grid.Column="3"
                        Content="Personalizado"
                        Style="{StaticResource PeriodBtn}"
                        Margin="0,0,4,0"
                        Click="BtnPeriodo_Click" Tag="custom"/>

                <!-- Separador visual -->
                <Border Grid.Column="4"
                        Width="1" Background="#DDDDDD"
                        Margin="4,3"/>

                <!-- Desde -->
                <DatePicker x:Name="DpDesde"
                            Grid.Column="5"
                            FontSize="12"
                            Width="100"
                            Margin="4,0,0,0"
                            SelectedDateChanged="Filtros_Changed"
                            IsEnabled="False"/>

                <!-- Hasta -->
                <TextBlock Grid.Column="7"
                           Text="hasta"
                           FontSize="12" Foreground="#666666"
                           VerticalAlignment="Center"/>
                <DatePicker x:Name="DpHasta"
                            Grid.Column="9"
                            FontSize="12"
                            Width="100"
                            Margin="0"
                            SelectedDateChanged="Filtros_Changed"
                            IsEnabled="False"/>

                <!-- Filtro empleado -->
                <ComboBox x:Name="CmbEmpleado"
                          Grid.Column="11"
                          VerticalContentAlignment="Center"
                          Width="140"
                          FontSize="12"
                          Padding="8,0"
                          Height="30"
                          SelectionChanged="Filtros_Changed"/>
            </Grid>

            <!-- ── Cards métricas ── -->
            <UniformGrid Grid.Row="2" Rows="1" Columns="4"
                         Margin="20,12,20,0">

                <!-- Total ingresos -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#EEEEEE" BorderThickness="0.5"
                        Padding="14,12" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Total ingresos" FontSize="11" Foreground="#666666"/>
                        <TextBlock x:Name="TxtIngresos"
                                   Text="$0"
                                   FontSize="20" FontWeight="Medium" Foreground="#1B5E20"
                                   Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtPeriodoCard"
                                   Text="Esta semana"
                                   FontSize="11" Foreground="#AAAAAA"/>
                    </StackPanel>
                </Border>

                <!-- Transacciones -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#EEEEEE" BorderThickness="0.5"
                        Padding="14,12" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Transacciones" FontSize="11" Foreground="#666666"/>
                        <TextBlock x:Name="TxtTransacciones"
                                   Text="0"
                                   FontSize="20" FontWeight="Medium" Foreground="#1A1A1A"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="operaciones registradas" FontSize="11" Foreground="#AAAAAA"/>
                    </StackPanel>
                </Border>

                <!-- Ticket promedio -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#EEEEEE" BorderThickness="0.5"
                        Padding="14,12" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Ticket promedio" FontSize="11" Foreground="#666666"/>
                        <TextBlock x:Name="TxtTicket"
                                   Text="$0"
                                   FontSize="20" FontWeight="Medium" Foreground="#1A1A1A"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="por transacción" FontSize="11" Foreground="#AAAAAA"/>
                    </StackPanel>
                </Border>

                <!-- Mejor día -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#EEEEEE" BorderThickness="0.5"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Mejor día" FontSize="11" Foreground="#666666"/>
                        <TextBlock x:Name="TxtMejorDia"
                                   Text="—"
                                   FontSize="20" FontWeight="Medium" Foreground="#1A1A1A"
                                   Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtMejorDiaSub"
                                   Text="sin datos"
                                   FontSize="11" Foreground="#AAAAAA"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ── Gráfico de barras ── -->
            <Border Grid.Row="3"
                    Background="White" CornerRadius="8"
                    BorderBrush="#EEEEEE" BorderThickness="0.5"
                    Margin="20,12,20,0" Padding="16,14">
                <StackPanel>
                    <TextBlock x:Name="TxtGraficoTitulo"
                               Text="Ingresos por día"
                               FontSize="12" FontWeight="Medium"
                               Foreground="#666666" Margin="0,0,0,10"/>
                    <!-- Barras -->
                    <Grid x:Name="GraficoGrid" Height="80">
                        <!-- Las columnas se generan en code-behind -->
                    </Grid>
                    <!-- Etiquetas de días -->
                    <Grid x:Name="GraficoLabels" Height="16" Margin="0,4,0,0">
                        <!-- Las etiquetas se generan en code-behind -->
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Tabla detalle por día ── -->
            <Grid Grid.Row="4" Margin="20,12,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cabecera tabla -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtTablaTitulo"
                               Grid.Column="0"
                               Text="Detalle por día"
                               FontSize="13" FontWeight="Medium"
                               Foreground="#1A1A1A"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTablaCount"
                               Grid.Column="1"
                               Text="0 registros"
                               FontSize="12" Foreground="#666666"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Tabla + paginación -->
                <Border Grid.Row="1" Background="White" CornerRadius="8"
                        BorderBrush="#EEEEEE" BorderThickness="0.5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="DgReporte"
                                  Grid.Row="0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F0F0"
                                  BorderThickness="0"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FAFAFA"
                                  FontSize="12"
                                  ColumnHeaderHeight="36"
                                  RowHeight="36"
                                  SelectionMode="Single"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background"  Value="#2E7D32"/>
                                    <Setter Property="Foreground"  Value="White"/>
                                    <Setter Property="FontSize"    Value="11"/>
                                    <Setter Property="FontWeight"  Value="Medium"/>
                                    <Setter Property="Padding"     Value="12,0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <!-- Día con badge "mejor" -->
                                <DataGridTemplateColumn Header="Día" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="12,0">
                                                <TextBlock Text="{Binding DiaNombre}"
                                                           FontWeight="Medium"
                                                           Foreground="#1A1A1A"
                                                           VerticalAlignment="Center"/>
                                                <Border x:Name="BadgeMejor"
                                                        Visibility="{Binding BadgeMejorVisibility}"
                                                        Background="#EAF3DE" CornerRadius="10"
                                                        Padding="6,1" Margin="6,0,0,0">
                                                    <TextBlock Text="mejor"
                                                               FontSize="10" Foreground="#27500A"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Fecha"
                                                    Binding="{Binding FechaDisplay}"
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#666666"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="0,0,0,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Empleado con badge gris -->
                                <DataGridTemplateColumn Header="Empleado" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F5F5F5" CornerRadius="10"
                                                    Padding="8,2" Margin="12,6"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Empleado}"
                                                           FontSize="11" Foreground="#666666"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Ventas"
                                                    Binding="{Binding CantidadVentas}"
                                                    Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Monto total"
                                                    Binding="{Binding TotalDisplay}"
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"       Value="#1B5E20"/>
                                            <Setter Property="FontWeight"       Value="Medium"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Ticket prom."
                                                    Binding="{Binding TicketDisplay}"
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"       Value="#666666"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Botón "Ver" -->
                                <DataGridTemplateColumn Header="Detalle" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Ver"
                                                    FontSize="11"
                                                    Padding="10,3"
                                                    Cursor="Hand"
                                                    Margin="6,0"
                                                    BorderBrush="#DDDDDD"
                                                    BorderThickness="0.5"
                                                    Background="Transparent"
                                                    Foreground="#666666"
                                                    Tag="{Binding Fecha}"
                                                    Click="BtnVerDia_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="bg"
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="6"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bg" Property="Background" Value="#EAF3DE"/>
                                                                            <Setter TargetName="bg" Property="BorderBrush" Value="#2E7D32"/>
                                                                            <Setter Property="Foreground" Value="#27500A"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Paginación -->
                        <Border Grid.Row="1"
                                BorderBrush="#EEEEEE" BorderThickness="0,0.5,0,0"
                                Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtPaginaInfo"
                                           Grid.Column="0"
                                           FontSize="12" Foreground="#666666"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            x:Name="PanelPaginacion"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>