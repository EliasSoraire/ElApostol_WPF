<Window x:Class="ElApostol_WPF.UI.Dueño.CambiarMiContrasenaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambiar mi contraseña"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F5F5F5"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="Campo" TargetType="PasswordBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F7F7F7"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Border Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1B5E20" Padding="22,16">
                <StackPanel>
                    <TextBlock Text="Cambiar mi contraseña" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="TxtSubtitulo" FontSize="12" Foreground="#B3FFFFFF" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Cuerpo -->
            <StackPanel Grid.Row="1" Margin="22,18,22,6">

                <TextBlock Text="CONTRASEÑA ACTUAL" Style="{StaticResource Etiqueta}"/>
                <PasswordBox x:Name="PbActual" Style="{StaticResource Campo}" PasswordChanged="Campo_Changed"/>

                <Border BorderBrush="#EEEEEE" BorderThickness="0,0.5,0,0" Margin="0,2,0,14"/>

                <TextBlock Text="NUEVA CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                <PasswordBox x:Name="PbNueva" Style="{StaticResource Campo}" PasswordChanged="Campo_Changed"/>

                <TextBlock Text="REPETIR NUEVA CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
                <PasswordBox x:Name="PbConfirmar" Style="{StaticResource Campo}" Margin="0,0,0,4"
                             PasswordChanged="Campo_Changed"/>
                <TextBlock x:Name="TxtHintPass" FontSize="11.5" Foreground="#888888" Margin="0,0,0,12"
                           Text="Mínimo 6 caracteres. Dejala vacía si solo querés cambiar la pregunta."
                           TextWrapping="Wrap"/>

                <!-- Pregunta de seguridad -->
                <Border Background="#F7F7F7" BorderBrush="#E3E3E3" BorderThickness="1"
                        CornerRadius="8" Padding="14,12">
                    <StackPanel>
                        <CheckBox x:Name="ChkPregunta" FontSize="13" FontWeight="SemiBold"
                                  Foreground="#1A1A1A" VerticalContentAlignment="Center"
                                  Content="Cambiar también la pregunta de seguridad"
                                  Checked="ChkPregunta_Changed" Unchecked="ChkPregunta_Changed"/>
                        <TextBlock x:Name="TxtPreguntaActual" FontSize="11.5" Foreground="#666666"
                                   TextWrapping="Wrap" Margin="22,4,0,0"/>

                        <StackPanel x:Name="PanelPregunta" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock Text="NUEVA PREGUNTA" Style="{StaticResource Etiqueta}"/>
                            <ComboBox x:Name="CmbPregunta" Height="36" FontSize="13"
                                      VerticalContentAlignment="Center" Margin="0,0,0,12"
                                      SelectionChanged="CmbPregunta_Changed">
                                <ComboBoxItem Content="Elegí una pregunta..."/>
                                <ComboBoxItem Content="¿Nombre de tu primera mascota?"/>
                                <ComboBoxItem Content="¿Ciudad donde naciste?"/>
                                <ComboBoxItem Content="¿Nombre de tu escuela primaria?"/>
                                <ComboBoxItem Content="¿Apodo de tu infancia?"/>
                                <ComboBoxItem Content="¿Marca de tu primer auto?"/>
                            </ComboBox>

                            <TextBlock Text="RESPUESTA" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtRespuesta" Height="36" FontSize="13" Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                                     TextChanged="TxtRespuesta_Changed"/>
                            <TextBlock FontSize="11.5" Foreground="#888888" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="No distingue mayúsculas. La vas a necesitar si olvidás la contraseña."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Error -->
                <Border x:Name="PanelError" Background="#FCEBEB" CornerRadius="6"
                        Padding="10,7" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError" FontSize="12" Foreground="#A32D2D" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="#EEEEEE" BorderThickness="0,0.5,0,0" Padding="22,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar" Height="38" FontSize="13"
                            Margin="0,0,10,0" Cursor="Hand" Background="Transparent"
                            BorderBrush="#DDDDDD" BorderThickness="0.5" Foreground="#666666"
                            IsCancel="True" Click="BtnCancelar_Click"/>
                    <Button x:Name="BtnGuardar" Grid.Column="1" Content="Guardar cambios"
                            Height="38" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                            Background="#2E7D32" Foreground="White" BorderThickness="0"
                            IsDefault="True" Click="BtnGuardar_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
