<Window x:Class="ElApostol_WPF.UI.Dueño.MenuDuenoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:ElApostol_WPF.UI.Shared"
        xmlns:local="clr-namespace:ElApostol_WPF.UI.Dueño"
        Title="El Apóstol — Panel Dueño"
        Height="700" Width="1050"
        MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F5F5F5"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBg"    Color="#1B5E20"/>
        <SolidColorBrush x:Key="Verde"         Color="#2E7D32"/>
        <SolidColorBrush x:Key="VerdeLight"    Color="#EAF3DE"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#111111"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#444444"/>
        <SolidColorBrush x:Key="TextTertiary"  Color="#888888"/>
        <SolidColorBrush x:Key="BorderColor"   Color="#DDDDDD"/>
        <SolidColorBrush x:Key="BgPrimary"     Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgSecondary"   Color="#F5F5F5"/>

        <!-- Estilo botón sidebar -->
        <Style x:Key="SbBtn" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="#D9FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="Medium"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding"      Value="10,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo botón sidebar ACTIVO -->
        <Style x:Key="SbBtnActive" TargetType="Button" BasedOn="{StaticResource SbBtn}">
            <Setter Property="Background" Value="#2DFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Estilo botón paginación -->
        <Style x:Key="PagBtn" TargetType="Button">
            <Setter Property="Padding"       Value="10,4"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="BorderBrush"   Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="Foreground"    Value="#666666"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ SIDEBAR ═══════════════ -->
        <Border Grid.Column="0" Background="#1B5E20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header usuario -->
                <Border Grid.Row="0" Padding="16,20,16,16"
                        BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,0.5">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="20"
                                Background="#26FFFFFF"
                                HorizontalAlignment="Left" Margin="0,0,0,8">
                            <TextBlock x:Name="TxtAvatar" Text="JR"
                                       FontSize="14" FontWeight="Medium"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtNombreUsuario"
                                   Text="Juan Rodríguez"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="White"/>
                        <TextBlock Text="Administrador · Dueño"
                                   FontSize="11"
                                   Foreground="#99FFFFFF"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Nav -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="8,12,8,0">

                        <TextBlock Text="GESTIÓN" FontSize="10"
                                   Foreground="#66FFFFFF"
                                   Margin="8,0,0,4"/>

                        <Button x:Name="BtnInventario" Style="{StaticResource SbBtnActive}"
                                Click="BtnInventario_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Path Width="16" Height="16" Margin="0,0,8,0"
                                          Fill="#CCFFFFff"
                                          Data="M1,1 H7 V7 H1 Z M9,1 H15 V7 H9 Z M1,9 H7 V15 H1 Z M9,9 H15 V15 H9 Z"/>
                                    <TextBlock Text="Inventario" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1FFFFFFF"
                                        CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="F1" FontSize="10" Foreground="#80FFFFFF"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button x:Name="BtnAgregarMaterial" Style="{StaticResource SbBtn}"
                                Click="BtnAgregarMaterial_Click" Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="15" Foreground="#CCFFFFff"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Agregar material" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1FFFFFFF"
                                        CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="F2" FontSize="10" Foreground="#80FFFFFF"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button x:Name="BtnNuevaVenta" Style="{StaticResource SbBtn}"
                                Click="BtnNuevaVenta_Click" Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="≡" FontSize="15" Foreground="#CCFFFFff"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Nueva venta" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1FFFFFFF"
                                        CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="F3" FontSize="10" Foreground="#80FFFFFF"/>
                                </Border>
                            </Grid>
                        </Button>

                        <TextBlock Text="REPORTES" FontSize="10"
                                   Foreground="#66FFFFFF"
                                   Margin="8,12,0,4"/>

                        <Button x:Name="BtnReporteVentas" Style="{StaticResource SbBtn}"
                                Click="BtnReporteVentas_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="📋" FontSize="12"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Reporte de ventas" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1FFFFFFF"
                                        CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="F4" FontSize="10" Foreground="#80FFFFFF"/>
                                </Border>
                            </Grid>
                        </Button>

                        <TextBlock Text="CONFIGURACIÓN" FontSize="10"
                                   Foreground="#66FFFFFF"
                                   Margin="8,12,0,4"/>

                        <Button x:Name="BtnGestionEmpleados" Style="{StaticResource SbBtn}"
                                Click="BtnGestionEmpleados_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="👤" FontSize="12"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Gestionar empleados" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1FFFFFFF"
                                        CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="F5" FontSize="10" Foreground="#80FFFFFF"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button x:Name="BtnCambiarClaveEmpleado" Style="{StaticResource SbBtn}"
                                Click="BtnCambiarClaveEmpleado_Click" Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="🔒" FontSize="12"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Cambiar clave empleado"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="110"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1FFFFFFF"
                                        CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="F6" FontSize="10" Foreground="#80FFFFFF"/>
                                </Border>
                            </Grid>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer cerrar sesión -->
                <Border Grid.Row="2" Padding="8,12"
                        BorderBrush="#1FFFFFFF" BorderThickness="0,0.5,0,0">
                    <Button Click="BtnCerrarSesion_Click" Cursor="Hand"
                            BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg"
                                        Background="#33DC3545"
                                        CornerRadius="6" Padding="10,9">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⇥" FontSize="14"
                                                   Foreground="#FFB3B3"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Cerrar sesión · F12"
                                                   FontSize="12" FontWeight="Medium"
                                                   Foreground="#FFB3B3"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#55DC3545"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>

            </Grid>
        </Border>

        <!-- ═══════════════ CONTENIDO PRINCIPAL ═══════════════ -->
        <Grid Grid.Column="1">
        <Grid x:Name="PanelInventario">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Margin="20,16,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Inventario de materiales"
                               FontSize="18" FontWeight="Medium"
                               Foreground="#111111"/>
                    <TextBlock Text="Mostrando 10 productos por página · Bodega principal"
                               FontSize="13" Foreground="#444444" Margin="0,1,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TxtFecha" Grid.Column="1"
                           FontSize="13" Foreground="#888888"
                           VerticalAlignment="Top"/>
            </Grid>

            <!-- Cards métricas -->
            <UniformGrid Grid.Row="1" Rows="1" Columns="4"
                         Margin="20,14,20,0">
                <!-- Total productos -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#EEEEEE" BorderThickness="0.5"
                        Padding="14,12" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Total productos" FontSize="13" Foreground="#444444"/>
                        <TextBlock x:Name="TxtTotalProductos" Text="0"
                                   FontSize="24" FontWeight="Medium" Foreground="#111111"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="en inventario" FontSize="12" Foreground="#888888"/>
                    </StackPanel>
                </Border>
                <!-- Stock crítico -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#EEEEEE" BorderThickness="0.5"
                        Padding="14,12" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Stock crítico" FontSize="13" Foreground="#A32D2D"/>
                        <TextBlock x:Name="TxtStockCritico" Text="0"
                                   FontSize="24" FontWeight="Medium" Foreground="#A32D2D"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="productos bajo mínimo" FontSize="12" Foreground="#888888"/>
                    </StackPanel>
                </Border>
                <!-- Valor inventario -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#EEEEEE" BorderThickness="0.5"
                        Padding="14,12" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Valor inventario" FontSize="13" Foreground="#854F0B"/>
                        <TextBlock x:Name="TxtValorInventario" Text="$0"
                                   FontSize="24" FontWeight="Medium" Foreground="#854F0B"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="total estimado" FontSize="12" Foreground="#888888"/>
                    </StackPanel>
                </Border>
                <!-- Ventas hoy -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#EEEEEE" BorderThickness="0.5"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Ventas hoy" FontSize="13" Foreground="#444444"/>
                        <TextBlock x:Name="TxtVentasHoy" Text="0"
                                   FontSize="24" FontWeight="Medium" Foreground="#111111"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="transacciones" FontSize="12" Foreground="#888888"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Área inventario -->
            <Grid Grid.Row="2" Margin="20,10,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar búsqueda -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtBusqueda" Grid.Column="0"
                             Height="36" FontSize="14" Padding="12,0"
                             VerticalContentAlignment="Center"
                             Background="White" BorderBrush="#BBBBBB"
                             BorderThickness="1" Margin="0,0,10,0"
                             Tag="Buscar por nombre o código..."
                             TextChanged="TxtBusqueda_TextChanged"
                             GotFocus="TxtBusqueda_GotFocus"
                             LostFocus="TxtBusqueda_LostFocus"/>

                    <ComboBox x:Name="CmbCategoria" Grid.Column="1"
                              Height="36" FontSize="12" Padding="10,0"
                              Background="White" BorderBrush="#BBBBBB"
                              VerticalContentAlignment="Center"
                              BorderThickness="0.5" Margin="0,0,10,0"
                              SelectionChanged="CmbCategoria_SelectionChanged"/>

                    <CheckBox x:Name="ChkVerInactivos" Grid.Column="2"
                              Content="Ver desactivados"
                              FontSize="12" Foreground="#444444"
                              VerticalAlignment="Center" Cursor="Hand"
                              Margin="0,0,12,0"
                              Checked="ChkVerInactivos_Changed"
                              Unchecked="ChkVerInactivos_Changed"/>

                    <Button Grid.Column="3" Content="+ Agregar material"
                            Height="36" Padding="14,0"
                            FontSize="13" FontWeight="Medium"
                            Foreground="White" BorderThickness="0"
                            Cursor="Hand" Click="BtnAgregarMaterial_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="#2E7D32"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#1B5E20"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Tabla + paginación -->
                <Border Grid.Row="1" Background="White" CornerRadius="8"
                        BorderBrush="#EEEEEE" BorderThickness="0.5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="DgProductos" Grid.Row="0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F0F0"
                                  BorderThickness="0"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FAFAFA"
                                  FontSize="13"
                                  FontWeight="Bold"
                                  Foreground="#000000"
                                  ColumnHeaderHeight="40"
                                  RowHeight="40"
                                  HorizontalContentAlignment="Stretch"
                                  SelectionMode="Single"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Foreground" Value="#000000"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}"
                                                        Padding="12,0">
                                                    <ContentPresenter VerticalAlignment="Center"
                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2E7D32"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontSize"   Value="13"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding"    Value="12,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código"    Binding="{Binding CodigoInterno}" Width="Auto" MinWidth="80"/>
                                <DataGridTextColumn Header="Material"  Binding="{Binding Nombre}"        Width="*" MinWidth="160"/>
                                <DataGridTextColumn Header="Marca"     Binding="{Binding Marca}"         Width="Auto" MinWidth="90"/>
                                <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="Auto" MinWidth="90"/>
                                <DataGridTextColumn Header="Precio"    Binding="{Binding PrecioDisplay}" Width="Auto" MinWidth="80"/>
                                <DataGridTextColumn Header="Medida"    Binding="{Binding MedidaDisplay}" Width="Auto" MinWidth="70"/>
                                <DataGridTemplateColumn Header="Stock" Width="Auto" MinWidth="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="6,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding StockBadgeBg}">
                                                <TextBlock Text="{Binding StockDisplay}"
                                                           FontSize="15" FontWeight="Bold"
                                                           Foreground="{Binding StockBadgeFg}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Acción" Width="Auto" MinWidth="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Editar" FontSize="13"
                                                        Padding="10,5" Cursor="Hand"
                                                        VerticalAlignment="Center"
                                                        BorderBrush="#DDDDDD" BorderThickness="0.5"
                                                        Background="#87CEEB"
                                                        Tag="{Binding Id}"
                                                        Visibility="{Binding VisibilidadActivo}"
                                                        Click="BtnEditar_Click"/>
                                                <Button Content="Eliminar" FontSize="13"
                                                        Padding="10,5" Cursor="Hand"
                                                        VerticalAlignment="Center"
                                                        Margin="6,0,0,0"
                                                        BorderBrush="#DDDDDD" BorderThickness="0.5"
                                                        Background="#F5A9A9"
                                                        Tag="{Binding Id}"
                                                        Visibility="{Binding VisibilidadActivo}"
                                                        Click="BtnEliminar_Click"/>
                                                <Button Content="Reactivar" FontSize="13"
                                                        Padding="10,5" Cursor="Hand"
                                                        VerticalAlignment="Center"
                                                        BorderBrush="#DDDDDD" BorderThickness="0.5"
                                                        Background="#C0DD97"
                                                        Tag="{Binding Id}"
                                                        Visibility="{Binding VisibilidadInactivo}"
                                                        Click="BtnReactivar_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Paginación -->
                        <Border Grid.Row="1" BorderBrush="#EEEEEE"
                                BorderThickness="0,0.5,0,0" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtPaginaInfo"
                                           Grid.Column="0"
                                           FontSize="13" Foreground="#444444"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" x:Name="PanelPaginacion"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <shared:NuevaVentaControl x:Name="CtrlNuevaVenta" Visibility="Collapsed"/>
        <local:GestionEmpleadosControl x:Name="CtrlGestionEmpleados" Visibility="Collapsed"/>
        <local:ReporteVentasControl x:Name="CtrlReporteVentas" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>